{
  "name": "@clubmanager/types",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npx tsc",
    "generate:domain": "node scripts/generate-domain.js",
    "audit:structure": "sh scripts/audit-domain-structure.sh",
    "audit:graphql": "sh scripts/audit-graphql.sh",
    "validate:domain": "sh scripts/validate-domain.sh"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.10",
    "jest": "^29.7.0",
    "stripe": "^20.3.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "graphql-tag": "^2.12.6",
    "zod": "^3.25.76"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./graphql": {
      "import": "./dist/core/graphql.js",
      "types": "./dist/core/graphql.d.ts"
    },
    "./domains/*": {
      "import": "./dist/domains/*.js",
      "types": "./dist/domains/*.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "types": "./dist/index.d.ts"
}
