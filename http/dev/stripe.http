### ============================================
### STRIPE
### ClubManager API - Stripe Webhooks & Payments (REST)
### ============================================

### Variables
@baseUrl = http://localhost:4000
@graphqlEndpoint = {{baseUrl}}/graphql
@stripeWebhookEndpoint = {{baseUrl}}/api/stripe/webhook
@token = YOUR_TOKEN_HERE
@adminToken = YOUR_ADMIN_TOKEN_HERE

# Stripe Test Keys
@stripePublishableKey = pk_test_YOUR_KEY
@stripeSecretKey = sk_test_YOUR_KEY
@stripeWebhookSecret = whsec_YOUR_SECRET

# Test IDs
@customerId = cus_test123
@subscriptionId = sub_test123
@paymentIntentId = pi_test123

### ============================================
### WEBHOOKS (REST - POST /api/stripe/webhook)
### ============================================

### 1. Simulate: Payment Intent Succeeded
POST {{stripeWebhookEndpoint}}
Content-Type: application/json
Stripe-Signature: t=1234567890,v1=mock_signature

{
  "id": "evt_test_webhook",
  "object": "event",
  "type": "payment_intent.succeeded",
  "data": {
    "object": {
      "id": "{{paymentIntentId}}",
      "object": "payment_intent",
      "amount": 2999,
      "currency": "eur",
      "customer": "{{customerId}}",
      "status": "succeeded",
      "metadata": {
        "user_id": "1",
        "commande_id": "123"
      }
    }
  }
}

### 2. Simulate: Payment Intent Failed
POST {{stripeWebhookEndpoint}}
Content-Type: application/json
Stripe-Signature: t=1234567890,v1=mock_signature

