# =============================================================================
# ClubManager Frontend V2 - Environment Variables Template
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local (for local development)
# 2. Fill in the actual values (DO NOT commit .env.local to git!)
# 3. Never hardcode secrets in code or vite.config.ts
#
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Stripe Configuration
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_test_key_here

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
VITE_APP_NAME=ClubManager
VITE_APP_VERSION=2.0.0
VITE_APP_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_QUERY_DEVTOOLS=true
VITE_ENABLE_REDUX_DEVTOOLS=true

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
VITE_AUTH_TOKEN_KEY=clubmanager_auth_token
VITE_AUTH_REFRESH_TOKEN_KEY=clubmanager_refresh_token
VITE_SESSION_TIMEOUT=3600000

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
VITE_LOG_LEVEL=debug
VITE_ENABLE_CONSOLE_LOGS=true

# Optional: Sentry DSN for error tracking (production)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Analytics (Google Analytics, Mixpanel, etc.)
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X
# VITE_MIXPANEL_TOKEN=your_mixpanel_token

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------
# Mock API responses (useful for offline development)
VITE_USE_MOCK_API=false

# Enable debug features
VITE_DEBUG_MODE=true
