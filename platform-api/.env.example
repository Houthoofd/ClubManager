# TEMPLATE - Copiez ce fichier vers .env.development et .env.production
# et remplacez les valeurs par vos vraies clés

# Configuration base de données
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=clubmanager

# Configuration SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_email@yourdomain.com
SENDGRID_SANDBOX=false

# Configuration email SMTP
EMAIL_SERVICE=sendgrid
EMAIL_FROM_NAME=Club Manager
ADMIN_EMAIL=admin@yourdomain.com
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key_here

# URL Frontend
FRONTEND_URL=http://localhost:5173

# Configuration JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# Configuration Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Environnement
NODE_ENV=development
