# Redis Configuration
# ==================

# Redis connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis key prefix (for multi-app deployments)
REDIS_KEY_PREFIX=clubmanager:

# Redis connection options
REDIS_MAX_RETRIES=3
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000

# Cache configuration
CACHE_ENABLED=true
CACHE_FAIL_SILENTLY=true
CACHE_LOG_ERRORS=true
CACHE_FALLBACK_DB=true

# Cache metrics
CACHE_METRICS_ENABLED=false

# Rate limiting configuration
# ===========================

# Global rate limits (per IP)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GLOBAL_WINDOW=60

# Authentication endpoints (stricter)
RATE_LIMIT_AUTH=5
RATE_LIMIT_AUTH_WINDOW=300

# API endpoints (per tenant/user)
RATE_LIMIT_API=1000
RATE_LIMIT_API_WINDOW=60

# Webhook endpoints
RATE_LIMIT_WEBHOOK=100
RATE_LIMIT_WEBHOOK_WINDOW=60

# Redis Production Settings (optional)
# =====================================

# Redis Cluster (for production)
# REDIS_CLUSTER_NODES=redis-1:6379,redis-2:6379,redis-3:6379

# Redis Sentinel (for high availability)
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_NODES=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379

# TLS/SSL
# REDIS_TLS_ENABLED=false
# REDIS_TLS_CA_PATH=/path/to/ca.crt
# REDIS_TLS_CERT_PATH=/path/to/client.crt
# REDIS_TLS_KEY_PATH=/path/to/client.key

# Connection pooling
# REDIS_MAX_CONNECTIONS=50
# REDIS_MIN_IDLE_CONNECTIONS=10
