// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SAAS MULTITENANCY MODELS
// ==========================================

model Tenant {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(50) // URL subdomain
  domain      String?  @unique @db.VarChar(100) // Custom domain
  status      TenantStatus @default(ACTIVE)
  plan        String   @db.VarChar(50) // BASIC, PRO, ENTERPRISE
  maxUsers    Int      @default(10)
  maxStorage  Int      @default(1000) // MB
  settings    Json?    // Tenant-specific settings
  stripeCustomerId String? @map("stripe_customer_id") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users       User[]
  subscriptions TenantSubscription[]
  auditLogs   AuditLog[]
  messages    Message[]
  cours       Cours[]
  paiements   Paiement[]
  echeances   EcheancePaiement[]
  articles    Article[]
  commandes   Commande[]
  notifications Notification[]
  groupes     Groupe[]
  alertes     AlerteUtilisateur[]

  @@map("tenants")
}

model TenantSubscription {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  planId      Int      @map("plan_id")
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("EUR") @db.VarChar(3)
  stripeSubscriptionId String? @map("stripe_subscription_id") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        PlanTarifaire @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("tenant_subscriptions")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  TRIAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  PENDING
}

// ==========================================
// AUDIT LOGGING (RGPD)
// ==========================================

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  userId      Int?     @map("user_id")
  action      String   @db.VarChar(100)  // CREATE, UPDATE, DELETE, LOGIN, etc.
  resource    String   @db.VarChar(100)  // users, payments, courses, etc.
  resourceId  String?  @map("resource_id")
  changes     Json?    // Avant/Après pour UPDATE
  ipAddress   String   @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  timestamp   DateTime @default(now())

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp])
  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@map("audit_logs")
}

// ==========================================
// TABLES DE RÉFÉRENCE (SHARED - NO TENANT)
// ==========================================

model Genre {
  id         Int           @id @default(autoincrement())
  genreName  String        @map("genre_name") @db.VarChar(50)
  users      User[]

  @@map("genres")
}

model Status {
  id          Int     @id @default(autoincrement())
  nomRole     String  @map("nom_role") @db.VarChar(50)
  description String? @db.Text
  users       User[]

  @@map("status")
}

model Grade {
  id      Int     @id @default(autoincrement())
  nom     String  @db.VarChar(50)
  ordre   Int?
  users   User[]

  @@map("grades")
}

model PlanTarifaire {
  id          Int       @id @default(autoincrement())
  nom         String    @db.VarChar(100)
  description String?   @db.Text
  prix        Decimal   @db.Decimal(10, 2)
  duree       Int?      // Durée en mois
  actif       Boolean   @default(true)
  maxUsers    Int       @default(10)
  maxStorage  Int       @default(1000) // MB
  features    Json?     // Features included in plan
  stripePriceId String? @map("stripe_price_id") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  subscriptions TenantSubscription[]
  users        User[]            @relation("UserSubscription")
  paiements    Paiement[]

  @@map("plans_tarifaires")
}

model Taille {
  id       Int      @id @default(autoincrement())
  nom      String   @unique @db.VarChar(10)
  articles Article[]

  @@map("tailles")
}

// ==========================================
// UTILISATEURS (TENANT-SPECIFIC)
// ==========================================

model User {
  id           Int       @id @default(autoincrement())
  tenantId     String    @map("tenant_id") // Association au tenant
  firstName    String    @map("first_name") @db.VarChar(50)
  lastName     String    @map("last_name") @db.VarChar(50)
  email        String    @db.VarChar(100) // Remove unique for multi-tenant
  password     String?   @db.VarChar(255)
  genderId     Int?      @map("gender")
  dateOfBirth  DateTime  @map("date_of_birth") @db.Date
  statusId     Int       @default(1) @map("status_id")
  gradeId      Int       @default(1) @map("grade")
  abonnementId Int?      @map("abonnement")
  userId       String?   @map("user_id") @db.VarChar(50)
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  genre           Genre?            @relation(fields: [genderId], references: [id])
  status          Status            @relation(fields: [statusId], references: [id])
  grade           Grade             @relation(fields: [gradeId], references: [id])
  abonnement      PlanTarifaire?    @relation("UserSubscription", fields: [abonnementId], references: [id])

  // Relations inverses
  inscriptions    Inscription[]
  paiements       Paiement[]
  reservations    Reservation[]
  commandes       Commande[]
  messagesEnvoyes Message[]         @relation("MessageSender")
  messagesRecus   Message[]         @relation("MessageReceiver")
  notifications   Notification[]
  groupes         GroupeUtilisateur[]
  alertes         AlerteUtilisateur[]
  actionsAlertes  AlerteAction[]
  auditLogs       AuditLog[]
  passwordResets  PasswordResetToken[]

  // Unique constraint par tenant
  @@unique([email, tenantId], name: "unique_email_per_tenant")
  @@index([tenantId])
  @@index([tenantId, actif])
  @@index([tenantId, email])
  @@map("users")
}

// ==========================================
// PASSWORD RESET
// ==========================================

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @db.VarChar(255) // Hashed token
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// ==========================================
// COURS (TENANT-SPECIFIC)
// ==========================================

model Cours {
  id          Int       @id @default(autoincrement())
  tenantId    String    @map("tenant_id") // ✅ AJOUTÉ
  dateCours   DateTime  @map("date_cours") @db.Date
  typeCours   String    @map("type_cours") @db.VarChar(50)
  heureDebut  DateTime  @map("heure_debut") @db.Time(0)
  heureFin    DateTime  @map("heure_fin") @db.Time(0)
  capaciteMax Int?      @map("capacite_max")
  description String?   @db.Text
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inscriptions Inscription[]
  reservations Reservation[]

  @@index([tenantId])
  @@index([tenantId, dateCours])
  @@index([tenantId, typeCours])
  @@index([dateCours])
  @@index([typeCours])
  @@map("cours")
}

model Inscription {
  id            Int       @id @default(autoincrement())
  utilisateurId Int       @map("utilisateur_id")
  coursId       Int       @map("cours_id")
  statusId      Int       @default(1) @map("status_id")
  dateInscription DateTime @default(now()) @map("date_inscription")
  present       Boolean   @default(false)
  notes         String?   @db.Text

  // Relations
  utilisateur User  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  cours       Cours @relation(fields: [coursId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, coursId])
  @@index([coursId])
  @@index([statusId])
  @@map("inscriptions")
}

model Reservation {
  id            Int       @id @default(autoincrement())
  utilisateurId Int       @map("utilisateur_id")
  coursId       Int       @map("cours_id")
  dateReservation DateTime @default(now()) @map("date_reservation")
  statut        String    @default("confirmée") @db.VarChar(50)
  notes         String?   @db.Text

  // Relations
  utilisateur User  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  cours       Cours @relation(fields: [coursId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, coursId])
  @@index([coursId])
  @@map("reservations")
}

// ==========================================
// PAIEMENTS (TENANT-SPECIFIC)
// ==========================================

model Paiement {
  id            Int       @id @default(autoincrement())
  tenantId      String    @map("tenant_id") // ✅ AJOUTÉ
  utilisateurId Int       @map("utilisateur_id")
  montant       Decimal   @db.Decimal(10, 2)
  datePaiement  DateTime  @map("date_paiement") @db.Date
  statut        String    @default("en attente") @db.VarChar(50)
  abonnementId  Int?      @map("abonnement_id")
  periodeDebut  DateTime? @map("periode_debut") @db.Date
  periodeFin    DateTime? @map("periode_fin") @db.Date
  methode       String?   @db.VarChar(50)
  transactionId String?   @map("transaction_id") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  utilisateur User           @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  abonnement  PlanTarifaire? @relation(fields: [abonnementId], references: [id])

  @@unique([tenantId, utilisateurId, periodeDebut])
  @@index([tenantId])
  @@index([tenantId, utilisateurId])
  @@index([tenantId, statut])
  @@index([tenantId, datePaiement])
  @@index([utilisateurId])
  @@index([statut])
  @@index([datePaiement])
  @@map("paiements")
}

model EcheancePaiement {
  id            Int       @id @default(autoincrement())
  tenantId      String    @map("tenant_id") // ✅ AJOUTÉ
  utilisateurId Int       @map("utilisateur_id")
  montant       Decimal   @db.Decimal(10, 2)
  dateEcheance  DateTime  @map("date_echeance") @db.Date
  statut        String    @default("en attente") @db.VarChar(50)
  rappelEnvoye  Boolean   @default(false) @map("rappel_envoye")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, utilisateurId])
  @@index([tenantId, dateEcheance])
  @@index([tenantId, statut])
  @@index([utilisateurId])
  @@index([dateEcheance])
  @@index([statut])
  @@map("echeances_paiements")
}

// ==========================================
// BOUTIQUE / MAGASIN (TENANT-SPECIFIC)
// ==========================================

model Article {
  id          Int       @id @default(autoincrement())
  tenantId    String    @map("tenant_id") // ✅ AJOUTÉ
  nom         String    @db.VarChar(100)
  description String?   @db.Text
  prix        Decimal   @db.Decimal(10, 2)
  tailleId    Int?      @map("taille_id")
  imageUrl    String?   @map("image_url") @db.VarChar(255)
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taille           Taille?           @relation(fields: [tailleId], references: [id])
  stock            Stock[]
  commandesArticles CommandeArticle[]

  @@index([tenantId])
  @@index([tenantId, actif])
  @@index([tailleId])
  @@index([actif])
  @@map("articles")
}

model Stock {
  id         Int      @id @default(autoincrement())
  articleId  Int      @map("article_id")
  quantite   Int      @default(0)
  seuil_min  Int?     @default(5)
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId])
  @@map("stock")
}

model Commande {
  id            Int       @id @default(autoincrement())
  tenantId      String    @map("tenant_id") // ✅ AJOUTÉ
  utilisateurId Int       @map("utilisateur_id")
  dateCommande  DateTime  @default(now()) @map("date_commande")
  statut        String    @default("en attente") @db.VarChar(50)
  montantTotal  Decimal   @map("montant_total") @db.Decimal(10, 2)
  adresseLivraison String? @map("adresse_livraison") @db.Text
  notes         String?   @db.Text

  // Relations
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  utilisateur User              @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  articles    CommandeArticle[]

  @@index([tenantId])
  @@index([tenantId, utilisateurId])
  @@index([tenantId, statut])
  @@index([tenantId, dateCommande])
  @@index([utilisateurId])
  @@index([statut])
  @@index([dateCommande])
  @@map("commandes")
}

model CommandeArticle {
  id         Int     @id @default(autoincrement())
  commandeId Int     @map("commande_id")
  articleId  Int     @map("article_id")
  quantite   Int     @default(1)
  prixUnitaire Decimal @map("prix_unitaire") @db.Decimal(10, 2)

  // Relations
  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  article  Article  @relation(fields: [articleId], references: [id])

  @@unique([commandeId, articleId])
  @@index([articleId])
  @@map("commandes_articles")
}

// ==========================================
// COMMUNICATION (TENANT-SPECIFIC)
// ==========================================

model Message {
  id             Int       @id @default(autoincrement())
  tenantId       String    @map("tenant_id")
  senderId       Int       @map("expediteur_id")
  recipientId    Int?      @map("destinataire_id")
  subject        String    @map("sujet") @db.VarChar(200)
  body           String    @map("contenu") @db.Text
  status         String    @default("DRAFT") @db.VarChar(50)
  priority       String    @default("NORMAL") @db.VarChar(50)
  type           String    @default("prive") @db.VarChar(50)
  scheduledFor   DateTime? @map("scheduled_for")
  sentAt         DateTime? @map("sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  readAt         DateTime? @map("read_at")
  read           Boolean   @default(false) @map("lu")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender       User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User?  @relation("MessageReceiver", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, senderId])
  @@index([tenantId, recipientId])
  @@index([tenantId, status])
  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([priority])
  @@index([scheduledFor])
  @@index([sentAt])
  @@index([deliveredAt])
  @@index([readAt])
  @@index([read])
  @@index([createdAt])
  @@map("messages")
}

model MessagePersonnalise {
  id        Int      @id @default(autoincrement())
  titre     String   @db.VarChar(200)
  contenu   String   @db.Text
  type      String   @db.VarChar(50)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("messages_personnalises")
}

model Notification {
  id            Int       @id @default(autoincrement())
  tenantId      String    @map("tenant_id") // ✅ AJOUTÉ
  utilisateurId Int       @map("utilisateur_id")
  titre         String    @db.VarChar(200)
  message       String    @db.Text
  type          String    @db.VarChar(50)
  lu            Boolean   @default(false)
  lien          String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  utilisateur User   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, utilisateurId])
  @@index([tenantId, lu])
  @@index([utilisateurId])
  @@index([lu])
  @@index([createdAt])
  @@map("notifications")
}

// ==========================================
// GROUPES (TENANT-SPECIFIC)
// ==========================================

model Groupe {
  id          Int      @id @default(autoincrement())
  tenantId    String   @map("tenant_id") // ✅ AJOUTÉ
  nom         String   @db.VarChar(100)
  description String?  @db.Text
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membres GroupeUtilisateur[]

  @@index([tenantId])
  @@index([tenantId, actif])
  @@map("groupes")
}

model GroupeUtilisateur {
  id            Int      @id @default(autoincrement())
  groupeId      Int      @map("groupe_id")
  utilisateurId Int      @map("utilisateur_id")
  role          String?  @default("membre") @db.VarChar(50)
  dateAjout     DateTime @default(now()) @map("date_ajout")

  // Relations
  groupe      Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  utilisateur User   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([groupeId, utilisateurId])
  @@index([utilisateurId])
  @@map("groupes_utilisateurs")
}

// ==========================================
// SYSTÈME D'ALERTES (TENANT-SPECIFIC)
// ==========================================

model AlerteType {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  nom         String    @db.VarChar(100)
  description String?   @db.Text
  priorite    String    @default("normale") @db.VarChar(20)
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  alertes AlerteUtilisateur[]

  @@map("alertes_types")
}

model AlerteUtilisateur {
  id              Int       @id @default(autoincrement())
  tenantId        String    @map("tenant_id") // ✅ AJOUTÉ
  utilisateurId   Int       @map("utilisateur_id")
  alerteTypeId    Int       @map("alerte_type_id")
  statut          String    @default("active") @db.VarChar(20)
  donneesContexte Json?     @map("donnees_contexte")
  dateDetection   DateTime  @default(now()) @map("date_detection")
  dateResolution  DateTime? @map("date_resolution")
  notes           String?   @db.Text

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  utilisateur User         @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  alerteType  AlerteType   @relation(fields: [alerteTypeId], references: [id], onDelete: Cascade)
  actions     AlerteAction[]

  @@index([tenantId])
  @@index([tenantId, utilisateurId])
  @@index([tenantId, statut])
  @@index([utilisateurId, statut])
  @@index([alerteTypeId, statut])
  @@map("alertes_utilisateurs")
}

model AlerteAction {
  id          Int      @id @default(autoincrement())
  alerteId    Int      @map("alerte_id")
  actionType  String   @map("action_type") @db.VarChar(50)
  description String?  @db.Text
  effectuePar Int?     @map("effectue_par")
  dateAction  DateTime @default(now()) @map("date_action")

  // Relations
  alerte      AlerteUtilisateur @relation(fields: [alerteId], references: [id], onDelete: Cascade)
  utilisateur User?             @relation(fields: [effectuePar], references: [id], onDelete: SetNull)

  @@index([alerteId, dateAction])
  @@map("alertes_actions")
}
