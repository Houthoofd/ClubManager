# ==========================================
# STRIPE CONFIGURATION
# ==========================================

# Stripe Secret Key (get from Stripe Dashboard)
# Test mode: sk_test_...
# Live mode: sk_live_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (for webhook signature verification)
# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==========================================
# STRIPE PRICE IDs (for each plan)
# ==========================================

# FREE plan - no Stripe price (free tier)
# STARTER plan price ID
STRIPE_PRICE_STARTER=price_your_starter_plan_price_id

# PRO plan price ID
STRIPE_PRICE_PRO=price_your_pro_plan_price_id

# ENTERPRISE plan price ID
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_plan_price_id

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

DATABASE_URL="mysql://user:password@localhost:3306/clubmanager"

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=5000

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# FRONTEND URLs
# ==========================================

FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:8081/admin

# ==========================================
# REDIS CONFIGURATION (Optional - for caching)
# ==========================================

REDIS_URL=redis://localhost:6379

# ==========================================
# EMAIL CONFIGURATION (for notifications)
# ==========================================

SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@clubmanager.com

# ==========================================
# AWS S3 CONFIGURATION (Optional - for file storage)
# ==========================================

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=clubmanager-files

# ==========================================
# NOTES
# ==========================================
#
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. Get Stripe keys from: https://dashboard.stripe.com/apikeys
# 4. Create products and prices in Stripe Dashboard for each plan
# 5. Set up webhook endpoint in Stripe Dashboard pointing to:
#    https://your-domain.com/webhooks/stripe
