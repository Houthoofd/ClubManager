# ============================================================================
# AWS S3 + CloudFront Deployment Configuration
# ============================================================================
# Copy this file to .env.aws and fill in your values
# This file is used by the deployment script: scripts/deploy-to-s3.sh
# ============================================================================

# ============================================================================
# AWS Credentials (for local deployment)
# ============================================================================
# Note: These are already configured in GitHub Secrets for CI/CD
# For local use, you can also use `aws configure` instead

AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# ============================================================================
# S3 Buckets (one per environment)
# ============================================================================

# Development
S3_BUCKET_DEV=clubmanager-frontend-dev

# Staging
S3_BUCKET_STAGING=clubmanager-frontend-staging

# Production
S3_BUCKET_PROD=clubmanager-frontend-prod

# ============================================================================
# CloudFront Distribution IDs
# ============================================================================
# Get these from AWS Console -> CloudFront -> Distributions
# Format: E1234567890ABC

# Development
CLOUDFRONT_DISTRIBUTION_ID_DEV=E1234567890ABC

# Staging
CLOUDFRONT_DISTRIBUTION_ID_STAGING=E2345678901BCD

# Production
CLOUDFRONT_DISTRIBUTION_ID_PROD=E3456789012CDE

# ============================================================================
# CloudFront Domains (optional)
# ============================================================================
# Custom domains or CloudFront default domains

CLOUDFRONT_DOMAIN_DEV=d111111abcdef8.cloudfront.net
CLOUDFRONT_DOMAIN_STAGING=d222222abcdef8.cloudfront.net
CLOUDFRONT_DOMAIN_PROD=app.clubmanager.com

# ============================================================================
# API Backend URLs
# ============================================================================
# These are injected into the frontend build as VITE_API_BASE_URL

# Development (local or dev server)
API_BASE_URL_DEV=http://localhost:4000

# Staging
API_BASE_URL_STAGING=https://api-staging.clubmanager.com

# Production
API_BASE_URL_PROD=https://api.clubmanager.com

# ============================================================================
# Frontend Build Environment Variables
# ============================================================================
# These are injected during the build process

# Stripe Public Keys (different per environment)
VITE_STRIPE_PUBLIC_KEY_DEV=pk_test_51xxxxxxxxxxxxx
VITE_STRIPE_PUBLIC_KEY_STAGING=pk_test_51xxxxxxxxxxxxx
VITE_STRIPE_PUBLIC_KEY_PROD=pk_live_51xxxxxxxxxxxxx

# Sentry DSN for error monitoring
VITE_SENTRY_DSN_DEV=https://xxxxx@o123456.ingest.sentry.io/123456
VITE_SENTRY_DSN_STAGING=https://xxxxx@o123456.ingest.sentry.io/123456
VITE_SENTRY_DSN_PROD=https://xxxxx@o123456.ingest.sentry.io/123456

# Google Analytics / Tag Manager (optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=true
VITE_ENABLE_STRIPE=true

# ============================================================================
# API/Backend Environment Variables (for EC2 deployment)
# ============================================================================
# These are used when deploying the API via the workflow

# EC2 Instance Details
EC2_HOST=ec2-xx-xxx-xxx-xxx.compute-1.amazonaws.com
EC2_USER=ubuntu
# EC2_SSH_PRIVATE_KEY is stored in GitHub Secrets (multiline)

# Database
DATABASE_URL=mysql://user:password@host:3306/clubmanager_prod

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here_change_me

# Stripe Secret Key
STRIPE_SECRET_KEY=sk_live_51xxxxxxxxxxxxx

# Email Service (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@clubmanager.com
SMTP_PASSWORD=your_smtp_password

# Other API secrets
SESSION_SECRET=your_session_secret_here

# ============================================================================
# ECS/Fargate Configuration (alternative to EC2)
# ============================================================================
# If using ECS instead of EC2

ECS_CLUSTER_NAME=clubmanager-cluster
ECS_SERVICE_NAME=clubmanager-api-service
ECS_TASK_DEFINITION=clubmanager-api-task

# ============================================================================
# Notifications (optional)
# ============================================================================
# For deployment notifications

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ============================================================================
# GitHub Container Registry (GHCR)
# ============================================================================
# These are automatically configured by GitHub Actions
# Repository format: ghcr.io/username/repo-name

GHCR_REGISTRY=ghcr.io
GHCR_IMAGE_API=ghcr.io/your-org/clubmanager/api
GHCR_IMAGE_FRONTEND=ghcr.io/your-org/clubmanager/frontend

# ============================================================================
# Deployment Options
# ============================================================================

# Target for API deployment: EC2 or ECS
DEPLOY_TARGET=EC2

# Enable/disable specific deployment steps
DEPLOY_FRONTEND=true
DEPLOY_API=true
RUN_MIGRATIONS=true
INVALIDATE_CLOUDFRONT=true

# ============================================================================
# Advanced S3 Configuration
# ============================================================================

# S3 Storage Class (STANDARD, INTELLIGENT_TIERING, etc.)
S3_STORAGE_CLASS=STANDARD

# Enable S3 versioning for rollback capability
S3_ENABLE_VERSIONING=true

# S3 Lifecycle rules (days)
S3_LIFECYCLE_TRANSITION_TO_IA_DAYS=30
S3_LIFECYCLE_EXPIRATION_DAYS=90

# ============================================================================
# CloudFront Advanced Configuration
# ============================================================================

# CloudFront Price Class (100=US+EU, 200=US+EU+Asia, All=Worldwide)
CLOUDFRONT_PRICE_CLASS=PriceClass_100

# Enable CloudFront compression
CLOUDFRONT_COMPRESS=true

# CloudFront cache behavior
CLOUDFRONT_DEFAULT_TTL=86400
CLOUDFRONT_MAX_TTL=31536000
CLOUDFRONT_MIN_TTL=0

# ============================================================================
# Route 53 (DNS) - Optional
# ============================================================================
# If using Route 53 for DNS management

ROUTE53_HOSTED_ZONE_ID=Z1234567890ABC
ROUTE53_DOMAIN_NAME=clubmanager.com
ROUTE53_SUBDOMAIN=app

# ============================================================================
# ACM (SSL Certificate) - Optional
# ============================================================================
# If using custom domain with HTTPS

ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxx

# ============================================================================
# Monitoring & Logging
# ============================================================================

# CloudWatch Log Group
CLOUDWATCH_LOG_GROUP=/aws/clubmanager

# CloudWatch Log Retention (days)
CLOUDWATCH_LOG_RETENTION_DAYS=30

# Enable detailed monitoring
ENABLE_DETAILED_MONITORING=false

# ============================================================================
# Cost Optimization
# ============================================================================

# S3 Request Payer (BucketOwner or Requester)
S3_REQUEST_PAYER=BucketOwner

# CloudFront Cache Behavior for cost optimization
OPTIMIZE_FOR_COST=true

# ============================================================================
# Security
# ============================================================================

# Enable S3 bucket encryption
S3_ENABLE_ENCRYPTION=true

# S3 bucket encryption type (AES256 or aws:kms)
S3_ENCRYPTION_TYPE=AES256

# Enable CloudFront WAF (Web Application Firewall)
ENABLE_WAF=false

# WAF Web ACL ARN
WAF_WEB_ACL_ARN=arn:aws:wafv2:us-east-1:123456789012:global/webacl/xxxxx

# ============================================================================
# Backup & Disaster Recovery
# ============================================================================

# Enable automated backups before deployment
ENABLE_PRE_DEPLOYMENT_BACKUP=true

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# S3 bucket for backups
S3_BACKUP_BUCKET=clubmanager-backups

# ============================================================================
# Development & Testing
# ============================================================================

# Skip confirmation prompts (use with caution!)
SKIP_CONFIRMATION=false

# Dry run mode (simulate deployment without making changes)
DRY_RUN=false

# Verbose logging
VERBOSE=false

# ============================================================================
# Notes
# ============================================================================
# 1. Never commit this file with real values to version control
# 2. Use different values for each environment
# 3. Rotate secrets regularly
# 4. Use AWS Secrets Manager or Parameter Store for sensitive data in production
# 5. For GitHub Actions, configure these as GitHub Secrets, not in .env files
