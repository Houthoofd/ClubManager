# ============================================================================
# CLUBMANAGER - ENVIRONMENT VARIABLES
# ============================================================================
#
# Instructions:
# 1. Copier ce fichier vers .env : cp .env.example .env
# 2. Remplacer les valeurs par vos vraies clés
# 3. Ne JAMAIS commiter le fichier .env
#
# ============================================================================

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================

# Clé publique Stripe (commence par pk_test_ ou pk_live_)
# Obtenir sur: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_51RWzE9BQMqChSZKpCmBYTuBAWMcSJzg9D17ltUMtPvH72XI6krdNQsLFQeXqCgPIVXos0L7EwRFjOSB6x1tbU1Zn00EiJkQHsZ

# Alternative (ancien nom, pour compatibilité)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ============================================================================
# API CONFIGURATION
# ============================================================================

# URL de base de l'API backend
VITE_API_BASE_URL=https://clubmanagment.com/

# Alternative (ancien nom, pour compatibilité)
# VITE_API_URL=http://localhost:3000

# Timeout des requêtes API (en millisecondes)
# VITE_API_TIMEOUT=30000

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Nom de l'application
# VITE_APP_NAME=ClubManager

# Version de l'application
# VITE_APP_VERSION=1.0.0

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Activer le mocking API (MSW) en développement
# VITE_USE_MOCKS=false

# Activer les outils de développement (React Query DevTools, etc.)
# VITE_ENABLE_DEVTOOLS=true

# Activer Google Analytics ou autre service d'analytics
# VITE_ENABLE_ANALYTICS=false

# Activer le tracking d'erreurs (Sentry, LogRocket, etc.)
# VITE_ENABLE_ERROR_TRACKING=false

# ============================================================================
# OPTIONAL - SERVICES EXTERNES
# ============================================================================

# Sentry DSN (si error tracking activé)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Google Analytics ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# LogRocket App ID
# VITE_LOGROCKET_APP_ID=xxx/clubmanager

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Port du serveur de développement
# PORT=5173

# Activer le mode debug
# VITE_DEBUG=false

# Afficher les logs GraphQL détaillés
# VITE_GRAPHQL_DEBUG=false

# ============================================================================
# NOTES
# ============================================================================
#
# Variables préfixées par VITE_ sont exposées au client
# Les autres sont disponibles uniquement côté build
#
# En production, utiliser les vraies clés:
# - pk_live_xxx pour Stripe
# - URL de production pour l'API
#
# ============================================================================
