# Configuration pour les tests d'intégration
# Base de données de test - séparée de la DB de développement

# Configuration base de données TEST
DATABASE_URL="mysql://root@localhost:3306/club_manager"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=club_manager

# Configuration JWT (test)
JWT_SECRET=test_secret_key_for_integration_tests_minimum_32_characters_long

# Configuration email (désactivé pour les tests)
SENDGRID_API_KEY=test_key
SENDGRID_FROM_EMAIL=test@test.com
SENDGRID_SANDBOX=true

# URL Frontend
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=test

# Stripe (ajouté automatiquement)
STRIPE_SECRET_KEY=sk_test_mock_key_for_testing_only_do_not_use_in_production_12345

# Email (ajouté automatiquement)
EMAIL_USER=test@clubmanager.local
EMAIL_PASS=test_password_for_email_service
EMAIL_FROM=noreply@clubmanager.local
EMAIL_HOST=smtp.test.local
EMAIL_PORT=587
STRIPE_PUBLISHABLE_KEY=pk_test_mock_key_for_testing_only
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
