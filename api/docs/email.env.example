# ============================================
# Configuration du Service Email
# ============================================
# Ce fichier contient toutes les options de configuration possibles
# pour le service email de ClubManager.
#
# UTILISATION :
# 1. Copiez les lignes dont vous avez besoin dans votre fichier .env
# 2. Décommentez et remplissez les valeurs appropriées
# 3. Le service détectera automatiquement le provider à utiliser
#
# PRIORITÉ DE DÉTECTION :
# 1. SendGrid (si SENDGRID_API_KEY est défini)
# 2. NodeMailer/SMTP (si SMTP_HOST est défini)
# 3. Service Custom (si CUSTOM_EMAIL_SERVICE est défini)
# 4. Console (par défaut, pour le développement)
# ============================================

# --------------------------------------------
# Configuration Générale (REQUIS pour tous)
# --------------------------------------------

# URL du frontend pour les liens dans les emails
FRONTEND_URL=http://localhost:3000

# Adresse email de l'expéditeur
FROM_EMAIL=noreply@clubmanager.com


# ============================================
# OPTION 1 : Mode Console (Développement)
# ============================================
# Aucune configuration supplémentaire requise
# Les emails seront affichés dans la console
# Idéal pour le développement local
# ============================================


# ============================================
# OPTION 2 : SendGrid (Recommandé pour Production)
# ============================================
# Service cloud professionnel avec dashboard analytics
# Inscription : https://sendgrid.com/
# Installation : npm install @sendgrid/mail
# ============================================

# Votre clé API SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================
# OPTION 3 : NodeMailer avec Gmail
# ============================================
# Utilisez un compte Gmail pour envoyer des emails
# IMPORTANT : Créez un "mot de passe d'application"
# Guide : https://support.google.com/accounts/answer/185833
# Installation : npm install nodemailer
# ============================================

# Configuration Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre.email@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx


# ============================================
# OPTION 4 : NodeMailer avec Outlook/Hotmail
# ============================================

# Configuration Outlook
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre.email@outlook.com
# SMTP_PASSWORD=votre_mot_de_passe


# ============================================
# OPTION 5 : NodeMailer avec Office 365
# ============================================

# Configuration Office 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre.email@votredomaine.com
# SMTP_PASSWORD=votre_mot_de_passe


# ============================================
# OPTION 6 : NodeMailer avec serveur SMTP personnalisé
# ============================================

# Configuration SMTP générique
# SMTP_HOST=smtp.votreserveur.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=username
# SMTP_PASSWORD=password


# ============================================
# OPTION 7 : Service Email Custom/Existant
# ============================================
# Si vous avez déjà un service d'email intégré
# (ex: messageClient.js dans votre projet)
# ============================================

# Activer le service custom
# CUSTOM_EMAIL_SERVICE=true


# ============================================
# Notes et Conseils
# ============================================
#
# SÉCURITÉ :
# - Ne commitez JAMAIS ce fichier avec de vraies credentials
# - Utilisez des mots de passe d'application pour Gmail
# - Gardez vos clés API secrètes
#
# SMTP_SECURE :
# - false (port 587) : TLS/STARTTLS (recommandé)
# - true (port 465) : SSL
#
# SMTP_PORT courants :
# - 587 : TLS/STARTTLS (le plus utilisé)
# - 465 : SSL
# - 25 : Non sécurisé (éviter)
#
# DÉBOGAGE :
# Pour voir quel provider est détecté au démarrage :
# Regardez les logs : "📧 [EmailService] Initialisé avec provider: xxx"
#
# TESTS :
# 1. Mode Console : Aucune config requise
# 2. Créez un utilisateur via l'API
# 3. Vérifiez les logs ou votre boîte mail
#
# PRODUCTION :
# - Utilisez SendGrid pour la fiabilité et les analytics
# - Configurez un domaine SPF/DKIM pour éviter le spam
# - Surveillez les quotas d'envoi
#
# ============================================
