# ==============================================
# CONFIGURATION PRODUCTION - ClubManager API
# ==============================================
# Copier ce fichier vers .env.production et configurer les valeurs

# ==============================================
# BASE DE DONNÉES
# ==============================================
DATABASE_URL="mysql://username:password@localhost:3306/clubmanager_production"

# ==============================================
# AUTHENTIFICATION & SÉCURITÉ
# ==============================================

# JWT Secret - OBLIGATOIRE EN PRODUCTION
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Durée de validité des access tokens (en secondes ou format: 15m, 1h, 7d)
# Recommandé: 15 minutes (900 secondes)
JWT_EXPIRES_IN=900

# Durée de validité des refresh tokens (en jours)
# Recommandé: 7 jours
REFRESH_TOKEN_EXPIRES_DAYS=7

# ==============================================
# RATE LIMITING
# ==============================================

# Nombre maximum de tentatives d'authentification échouées
RATE_LIMIT_MAX_ATTEMPTS=5

# Fenêtre de temps pour le comptage (en minutes)
RATE_LIMIT_WINDOW_MINUTES=15

# Durée de blocage après dépassement (en minutes)
RATE_LIMIT_BLOCK_DURATION_MINUTES=30

# ==============================================
# BCRYPT
# ==============================================

# Nombre de rounds pour le hachage bcrypt
# Recommandé: 12 (équilibre sécurité/performance)
# Plus élevé = plus sécurisé mais plus lent
BCRYPT_ROUNDS=12

# ==============================================
# CORS
# ==============================================

# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=https://votredomaine.com,https://app.votredomaine.com

# ==============================================
# APPLICATION
# ==============================================

# Environnement
NODE_ENV=production

# Port du serveur
PORT=3000

# URL de l'API
API_URL=https://api.votredomaine.com

# URL du frontend
FRONTEND_URL=https://votredomaine.com

# ==============================================
# EMAIL (SendGrid)
# ==============================================

# Clé API SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Email expéditeur vérifié
SENDGRID_FROM_EMAIL=noreply@votredomaine.com

# Nom de l'expéditeur
SENDGRID_FROM_NAME=ClubManager

# ==============================================
# STOCKAGE (AWS S3)
# ==============================================

# Clés d'accès AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Région AWS
AWS_REGION=eu-west-1

# Nom du bucket S3
AWS_S3_BUCKET=clubmanager-production

# ==============================================
# PAIEMENTS
# ==============================================

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=live

# ==============================================
# LOGS & MONITORING
# ==============================================

# Niveau de log (error, warn, info, debug)
LOG_LEVEL=info

# Activer les logs détaillés
ENABLE_QUERY_LOGGING=false

# ==============================================
# SÉCURITÉ AVANCÉE
# ==============================================

# Activer le HTTPS strict
FORCE_HTTPS=true

# Durée de session (en secondes)
SESSION_MAX_AGE=86400

# Activer la protection CSRF
ENABLE_CSRF_PROTECTION=true

# ==============================================
# MAINTENANCE
# ==============================================

# Intervalle de nettoyage des tokens expirés (en heures)
TOKEN_CLEANUP_INTERVAL_HOURS=24

# Rétention des anciennes tentatives d'auth (en jours)
AUTH_ATTEMPTS_RETENTION_DAYS=30

# Rétention des refresh tokens révoqués (en jours)
REFRESH_TOKENS_RETENTION_DAYS=30

# ==============================================
# RATE LIMITING AVANCÉ
# ==============================================

# Rate limit global (requêtes par IP)
GLOBAL_RATE_LIMIT_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_MINUTES=15

# Rate limit pour les inscriptions
REGISTER_RATE_LIMIT_REQUESTS=3
REGISTER_RATE_LIMIT_WINDOW_MINUTES=60

# Rate limit pour les récupérations de mot de passe
PASSWORD_RESET_RATE_LIMIT_REQUESTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# ==============================================
# NOTES DE SÉCURITÉ
# ==============================================
#
# IMPORTANT:
# - Ne JAMAIS commiter ce fichier avec des vraies valeurs
# - Utiliser un gestionnaire de secrets en production (AWS Secrets Manager, etc.)
# - Générer des clés cryptographiquement sûres
# - Changer TOUTES les valeurs par défaut
# - Limiter l'accès au fichier .env en production (chmod 600)
# - Auditer régulièrement les configurations
# - Activer la rotation automatique des secrets
# - Utiliser HTTPS uniquement
# - Configurer des backups sécurisés de la base de données
#
# ==============================================
