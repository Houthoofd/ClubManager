  @@index([recurring_course_id], map: "cours_recurrent_id")
  @@index([course_date], map: "idx_cours_date")
  @@index([sport_id, course_date, start_time], map: "idx_cours_planning")
  @@index([sport_id], map: "idx_cours_sport")
  @@index([sport_id, course_date], map: "idx_cours_sport_date")
  @@index([course_date, course_type], map: "idx_date_type")
  @@index([course_date, course_type, recurring_course_id], map: "idx_date_type_recurrent")
  @@index([deleted_at], map: "idx_deleted_at")
}

model course_types {
  id                Int                 @id @default(autoincrement())
  sport_id          Int?
