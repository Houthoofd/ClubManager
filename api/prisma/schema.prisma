generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ab_test_participants {
  id               Int              @id @default(autoincrement())
  test_id          Int
  variant_id       Int
  user_id          Int?
  session_id       String?          @db.VarChar(255)
  participated_at  DateTime         @default(now()) @db.Timestamp(0)
  converted        Boolean?         @default(false)
  converted_at     DateTime?        @db.Timestamp(0)
  ip_address       String?          @db.VarChar(45)
  user_agent       String?          @db.Text
  ab_tests         ab_tests         @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ab_test_participants_ibfk_1")
  ab_test_variants ab_test_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ab_test_participants_ibfk_2")
  users            users?           @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "ab_test_participants_ibfk_3")

  @@index([converted], map: "idx_converted")
  @@index([participated_at], map: "idx_participated_at")
  @@index([session_id], map: "idx_session_id")
  @@index([test_id, variant_id], map: "idx_test_variant")
  @@index([user_id], map: "idx_user_id")
  @@index([variant_id], map: "variant_id")
}

model ab_test_variants {
  id                   Int                    @id @default(autoincrement())
  test_id              Int
  variant_name         String                 @db.VarChar(50)
  content              Json
  email_template_id    Int?
  custom_subject       String?                @db.VarChar(500)
  participants_count   Int?                   @default(0)
  conversions_count    Int?                   @default(0)
  conversion_rate      Decimal?               @default(0.00) @db.Decimal(5, 2)
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  ab_test_participants ab_test_participants[]
  ab_tests             ab_tests               @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ab_test_variants_ibfk_1")
  email_templates      email_templates?       @relation(fields: [email_template_id], references: [id], onUpdate: NoAction, map: "ab_test_variants_ibfk_2")

  @@unique([test_id, variant_name], map: "uk_test_variant")
  @@index([email_template_id], map: "email_template_id")
  @@index([test_id], map: "idx_test_id")
}

model ab_tests {
  id                       Int                    @id @default(autoincrement())
  name                     String                 @db.VarChar(200)
  description              String?                @db.Text
  test_type                ab_tests_test_type
  resource_type            String?                @db.VarChar(100)
  resource_id              String?                @db.VarChar(100)
  status                   ab_tests_status?       @default(DRAFT)
  start_date               DateTime?              @db.Timestamp(0)
  end_date                 DateTime?              @db.Timestamp(0)
  traffic_split_percentage Int?                   @default(50)
  primary_metric           String                 @db.VarChar(100)
  winner_variant_id        Int?
  confidence_level         Decimal?               @db.Decimal(5, 2)
  created_by               Int?
  created_at               DateTime               @default(now()) @db.Timestamp(0)
  updated_at               DateTime               @default(now()) @db.Timestamp(0)
  ab_test_participants     ab_test_participants[]
  ab_test_variants         ab_test_variants[]
  email_campaigns          email_campaigns[]

  @@index([created_by], map: "idx_created_by")
  @@index([start_date, end_date], map: "idx_dates")
  @@index([status], map: "idx_status")
  @@index([test_type], map: "idx_test_type")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model account_deletion_requests {
  id                                                 Int                               @id @default(autoincrement())
  user_id                                            Int
  status                                             account_deletion_requests_status? @default(PENDING)
  reason                                             String?                           @db.Text
  requested_at                                       DateTime                          @default(now()) @db.Timestamp(0)
  approved_at                                        DateTime?                         @db.Timestamp(0)
  approved_by                                        Int?
  completed_at                                       DateTime?                         @db.Timestamp(0)
  rejection_reason                                   String?                           @db.Text
  request_ip                                         String?                           @db.VarChar(45)
  users_account_deletion_requests_approved_byTousers users?                            @relation("account_deletion_requests_approved_byTousers", fields: [approved_by], references: [id], onUpdate: Restrict, map: "fk_account_deletion_requests_approver")
  users_account_deletion_requests_user_idTousers     users                             @relation("account_deletion_requests_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_account_deletion_requests_user")

  @@index([approved_by], map: "idx_approved_by")
  @@index([requested_at], map: "idx_requested_at")
  @@index([status], map: "idx_status")
  @@index([user_id], map: "idx_user_id")
}

model alert_actions {
  id           Int                       @id @default(autoincrement())
  alert_id     Int
  action_type  alert_actions_action_type
  description  String?                   @db.Text
  performed_by Int?
  action_date  DateTime?                 @default(now()) @db.Timestamp(0)
  user_alerts  user_alerts               @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "alert_actions_ibfk_1")
  users        users?                    @relation(fields: [performed_by], references: [id], onUpdate: Restrict, map: "alert_actions_ibfk_2")

  @@index([performed_by], map: "effectue_par")
  @@index([alert_id, action_date], map: "idx_alerte_date")
}

model alert_types {
  id          Int                   @id @default(autoincrement())
  type_code   String                @unique(map: "type_code") @db.VarChar(50)
  name        String                @db.VarChar(100)
  description String?               @db.Text
  severity    alert_types_severity? @default(medium)
  active      Boolean?              @default(true)
  user_alerts user_alerts[]

  @@index([active], map: "idx_actif")
}

model api_key_usage_logs {
  id               BigInt   @id @default(autoincrement())
  api_key_id       Int
  endpoint         String   @db.VarChar(255)
  method           String   @db.VarChar(10)
  status_code      Int
  response_time_ms Int?
  ip_address       String?  @db.VarChar(45)
  user_agent       String?  @db.Text
  created_at       DateTime @default(now()) @db.Timestamp(0)
  api_keys         api_keys @relation(fields: [api_key_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_key_usage_logs_ibfk_1")

  @@index([api_key_id], map: "idx_api_key_id")
  @@index([created_at], map: "idx_created_at")
  @@index([endpoint], map: "idx_endpoint")
  @@index([status_code], map: "idx_status_code")
}

model api_keys {
  id                  Int                  @id @default(autoincrement())
  key_hash            String               @unique(map: "key_hash") @db.VarChar(255)
  key_prefix          String               @db.VarChar(20)
  name                String               @db.VarChar(200)
  description         String?              @db.Text
  user_id             Int?
  scopes              Json?
  allowed_ips         Json?
  rate_limit_override Int?
  active              Boolean?             @default(true)
  last_used_at        DateTime?            @db.Timestamp(0)
  usage_count         BigInt?              @default(0)
  expires_at          DateTime?            @db.Timestamp(0)
  created_at          DateTime             @default(now()) @db.Timestamp(0)
  updated_at          DateTime             @default(now()) @db.Timestamp(0)
  api_key_usage_logs  api_key_usage_logs[]
  users               users?               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_keys_ibfk_1")

  @@index([active], map: "idx_active")
  @@index([expires_at], map: "idx_expires_at")
  @@index([key_hash], map: "idx_key_hash")
  @@index([user_id], map: "idx_user_id")
}

model archive_statistics {
  id                 Int      @id @default(autoincrement())
  table_name         String   @db.VarChar(100)
  records_archived   Int
  records_deleted    Int
  execution_time_ms  Int?
  archived_from_date DateTime @db.Date
  archived_to_date   DateTime @db.Date
  created_at         DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_created_at")
  @@index([table_name], map: "idx_table_name")
}

model article_categories {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  description     String?           @db.Text
  shop_articles   shop_articles[]
  sport_equipment sport_equipment[]

  @@index([name], map: "idx_nom")
}

model article_images {
  id            Int           @id @default(autoincrement())
  article_id    Int
  url           String        @db.VarChar(255)
  alt_text      String?       @db.VarChar(255)
  sort_order    Int?          @default(0)
  shop_articles shop_articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "article_images_ibfk_1")

  @@index([article_id], map: "article_id")
}

model article_sizes {
  id            Int           @id @default(autoincrement())
  article_id    Int
  size_id       Int
  shop_articles shop_articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "article_sizes_ibfk_1")
  sizes         sizes         @relation(fields: [size_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "article_sizes_ibfk_2")

  @@index([article_id], map: "article_id")
  @@index([article_id, size_id], map: "idx_article_taille")
  @@index([size_id], map: "taille_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model article_stock {
  id                  Int           @id @default(autoincrement())
  article_id          Int
  size_id             Int
  quantity_total      Int           @default(0)
  quantity_reserved   Int           @default(0)
  quantity_available  Int           @default(0)
  last_restock_at     DateTime?     @db.DateTime(0)
  low_stock_threshold Int           @default(5)
  created_at          DateTime?     @default(now()) @db.Timestamp(0)
  updated_at          DateTime?     @default(now()) @db.Timestamp(0)
  shop_articles       shop_articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_article_stock_article")
  sizes               sizes         @relation(fields: [size_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_article_stock_taille")

  @@unique([article_id, size_id], map: "uk_article_taille")
  @@index([article_id, quantity_available], map: "idx_article_available")
  @@index([size_id], map: "idx_taille")
}

model audit_logs_archive {
  id            String   @id @db.VarChar(255)
  event_type    String   @db.VarChar(100)
  user_id       Int?
  resource_type String?  @db.VarChar(100)
