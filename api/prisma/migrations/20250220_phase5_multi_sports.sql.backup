-- ----------------------------------------------------------------------------
-- 11. VUES UTILES
-- ----------------------------------------------------------------------------

-- Vue: Sports actifs avec nombre de pratiquants
CREATE OR REPLACE VIEW `v_sports_summary` AS
SELECT
  s.id,
  s.code,
  s.name,
  s.color,
  s.icon,
  s.is_active,
  COUNT(DISTINCT us.user_id) as total_members,
  COUNT(DISTINCT c.id) as total_courses,
  COUNT(DISTINCT g.id) as total_grades,
  s.created_at
FROM `sports` s
LEFT JOIN `user_sports` us ON s.id = us.sport_id AND us.is_active = TRUE
LEFT JOIN `cours` c ON s.id = c.sport_id
LEFT JOIN `grades` g ON s.id = g.sport_id
GROUP BY s.id, s.code, s.name, s.color, s.icon, s.is_active, s.created_at
ORDER BY s.display_order;

-- Vue: Utilisateurs avec leurs sports
CREATE OR REPLACE VIEW `v_user_sports_details` AS
SELECT
  u.id as user_id,
  u.nom,
  u.prenom,
  u.email,
  s.id as sport_id,
  s.code as sport_code,
  s.name as sport_name,
  us.is_primary,
  us.is_active as practices_sport,
  g.nom as current_grade,
  us.started_at,
  us.notes
FROM `utilisateurs` u
INNER JOIN `user_sports` us ON u.id = us.user_id
INNER JOIN `sports` s ON us.sport_id = s.id
LEFT JOIN `grades` g ON us.current_grade_id = g.id
ORDER BY u.nom, u.prenom, us.is_primary DESC;

-- ----------------------------------------------------------------------------
-- 12. TRIGGERS POUR SYNCHRONISATION
-- ----------------------------------------------------------------------------

-- Trigger: Quand on change le grade d'un user, mettre à jour user_sports
DELIMITER //

CREATE TRIGGER `trg_update_user_sport_grade`
AFTER UPDATE ON `utilisateurs`
FOR EACH ROW
BEGIN
  IF OLD.grade_id != NEW.grade_id OR (OLD.grade_id IS NULL AND NEW.grade_id IS NOT NULL) THEN
    -- Mettre à jour le grade dans user_sports pour le sport principal
    UPDATE `user_sports`
    SET `current_grade_id` = NEW.grade_id,
        `updated_at` = CURRENT_TIMESTAMP
    WHERE `user_id` = NEW.id
      AND `is_primary` = TRUE;

    -- Ajouter à l'historique si le nouveau grade est lié à un sport
    IF NEW.grade_id IS NOT NULL THEN
      INSERT INTO `user_grade_history` (`user_id`, `sport_id`, `grade_id`, `obtained_at`)
      SELECT
        NEW.id,
        g.sport_id,
        NEW.grade_id,
        CURDATE()
      FROM `grades` g
      WHERE g.id = NEW.grade_id
        AND g.sport_id IS NOT NULL;
    END IF;
  END IF;
END//

DELIMITER ;

-- ----------------------------------------------------------------------------
-- 13. INDEXES DE PERFORMANCE SUPPLÉMENTAIRES
-- ----------------------------------------------------------------------------

-- Index composites pour requêtes fréquentes
CREATE INDEX `idx_user_sports_active_primary` ON `user_sports`(`is_active`, `is_primary`, `sport_id`);
CREATE INDEX `idx_grade_history_composite` ON `user_grade_history`(`user_id`, `sport_id`, `obtained_at`);
CREATE INDEX `idx_sport_equipment_level` ON `sport_equipment`(`sport_id`, `for_level`, `is_mandatory`);

-- ----------------------------------------------------------------------------
-- FIN DE LA MIGRATION PHASE 5
-- ----------------------------------------------------------------------------

-- Vérification du nombre de tables créées
SELECT
  'Phase 5 completed' as status,
  (SELECT COUNT(*) FROM information_schema.tables
   WHERE table_schema = DATABASE()
   AND table_name IN ('sports', 'sport_configurations', 'user_sports', 'user_grade_history',
                      'sport_equipment', 'sport_competition_rules', 'sport_statistics')) as new_tables,
  (SELECT COUNT(*) FROM `sports`) as total_sports,
  (SELECT COUNT(*) FROM `user_sports`) as user_sport_links;
