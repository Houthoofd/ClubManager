generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// NOUVELLES TABLES DE RÉFÉRENCE - PHASE 1
// ============================================================================

model PaymentMethod {
  id         Int          @id @default(autoincrement())
  code       String       @unique @db.VarChar(50)
  name       String       @db.VarChar(100)
  active     Boolean      @default(true)
  created_at DateTime     @default(now()) @db.Timestamp(0)

  paiements  paiements[]

  @@index([code], map: "idx_code")
  @@index([active], map: "idx_active")
  @@map("payment_methods")
}

model CourseType {
  id              Int               @id @default(autoincrement())
  sport_id        Int?
  code            String            @unique @db.VarChar(50)
  name            String            @db.VarChar(100)
  description     String?           @db.Text
  active          Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(0)

  cours_recurrent cours_recurrent[]
  sport           Sport?            @relation(fields: [sport_id], references: [id], onDelete: Cascade, map: "fk_course_types_sport")

  @@index([code], map: "idx_code")
  @@index([active], map: "idx_active")
  @@index([sport_id], map: "idx_course_types_sport")
  @@map("course_types")
}

// ============================================================================
// EMAIL QUEUE - File d'attente persistante pour les emails
// ============================================================================

model EmailQueue {
  id             Int              @id @default(autoincrement())
  to             String           @db.VarChar(255)
  subject        String?          @db.VarChar(500)
  template_title String?          @db.VarChar(100)
  variables      Json?
  html_content   String?          @db.Text

  // Gestion des tentatives
  attempts       Int              @default(0)
  max_attempts   Int              @default(5)
  next_retry_at  DateTime?        @db.DateTime(0)

  // Statut
  status         EmailQueueStatus @default(PENDING)

  // Métadonnées
  priority       Int              @default(0) // 0=normal, 1=high, -1=low
  created_at     DateTime         @default(now()) @db.DateTime(0)
  updated_at     DateTime         @updatedAt @db.DateTime(0)
  processed_at   DateTime?        @db.DateTime(0)

  // Erreurs
  last_error     String?          @db.Text
  error_details  Json?

  // Relations
  utilisateur_id Int?
  utilisateur    utilisateurs?    @relation(fields: [utilisateur_id], references: [id], onDelete: SetNull)

  // Correlation pour tracing
  correlation_id String?          @db.VarChar(36)

  @@index([status, next_retry_at], map: "idx_status_retry")
  @@index([status, priority, created_at], map: "idx_status_priority_created")
  @@index([utilisateur_id, status, created_at], map: "idx_user_status_created")
  @@index([correlation_id], map: "idx_correlation")
  @@index([utilisateur_id], map: "idx_utilisateur")
  @@map("email_queue")
}

enum EmailQueueStatus {
  PENDING      // En attente d'envoi
  PROCESSING   // En cours d'envoi
  COMPLETED    // Envoyé avec succès
  FAILED       // Échec définitif après max tentatives
}

// ============================================================================
// WEBHOOKS - Logs et traçabilité des événements Stripe
// ============================================================================

model WebhookLog {
  id            String           @id @default(cuid())
  event_id      String           @unique @db.VarChar(255)
  event_type    String           @db.VarChar(100)
  status        WebhookLogStatus
  payload       Json
  error         String?          @db.Text
  retry_count   Int              @default(0)
  next_retry_at DateTime?        @db.DateTime(0)
  processed_at  DateTime?        @db.DateTime(0)
  created_at    DateTime         @default(now()) @db.DateTime(0)
  updated_at    DateTime         @updatedAt @db.DateTime(0)

  @@index([event_type, status], map: "idx_event_type_status")
  @@index([status, created_at], map: "idx_status_created")
  @@index([event_type, status, created_at], map: "idx_event_status_created")
  @@index([created_at], map: "idx_created_at")
  @@map("webhook_logs")
}

enum WebhookLogStatus {
  PENDING
  SUCCESS
  FAILURE
  RETRYING
}

// ============================================================================
// SESSIONS - Gestion des sessions utilisateur
// ============================================================================

model Session {
  id               String       @id @default(cuid())
  token            String       @unique @db.VarChar(255)
  user_id          Int
  ip_address       String?      @db.VarChar(45)
  user_agent       String?      @db.Text
  device_type      String?      @db.VarChar(50)
  browser          String?      @db.VarChar(50)
  os               String?      @db.VarChar(50)
  is_active        Boolean      @default(true)
  last_activity_at DateTime     @default(now()) @db.DateTime(0)
  expires_at       DateTime     @db.DateTime(0)
  created_at       DateTime     @default(now()) @db.DateTime(0)
  updated_at       DateTime     @updatedAt @db.DateTime(0)

  utilisateur utilisateurs @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id, is_active], map: "idx_user_active")
  @@index([token], map: "idx_token")
  @@index([expires_at], map: "idx_expires_at")
  @@index([expires_at, is_active], map: "idx_expires_active")
  @@map("sessions")
}

// ============================================================================
// AUDIT LOGS - Journalisation des événements de sécurité et actions
// ============================================================================

model AuditLog {
  id           String   @id @default(cuid())
  event_type   String   @db.VarChar(100)
  severity     String   @db.VarChar(20)
  user_id      Int?
  ip_address   String?  @db.VarChar(45)
  user_agent   String?  @db.Text
  resource     String?  @db.VarChar(100)
  action       String?  @db.VarChar(100)
  success      Boolean  @default(true)
  error_code   String?  @db.VarChar(50)
  message      String?  @db.Text
  metadata     Json?
  timestamp    DateTime @default(now()) @db.DateTime(0)

  utilisateur utilisateurs? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([event_type, timestamp], map: "idx_event_type_timestamp")
  @@index([user_id, timestamp], map: "idx_user_timestamp")
  @@index([user_id, event_type, timestamp], map: "idx_user_event_timestamp")
  @@index([severity, timestamp], map: "idx_severity_timestamp")
  @@index([severity, success, timestamp], map: "idx_severity_success")
  @@index([timestamp], map: "idx_timestamp")
  @@map("audit_logs")
}

// ============================================================================
// EMAILS - Historique des emails envoyés
// ============================================================================

model Email {
  id              String      @id @default(cuid())
  to              String      @db.VarChar(255)
  subject         String      @db.VarChar(500)
  content         String      @db.Text
  html_content    String?     @db.Text
  status          EmailStatus @default(SENT)
  provider        String?     @db.VarChar(50) // 'sendgrid', 'smtp', etc.
  message_id      String?     @db.VarChar(255)
  error           String?     @db.Text
  utilisateur_id  Int?
  metadata        Json?       // Données additionnelles (template, variables, etc.)
  sent_at         DateTime    @default(now()) @db.DateTime(0)
  created_at      DateTime    @default(now()) @db.DateTime(0)

  utilisateur utilisateurs? @relation(fields: [utilisateur_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([utilisateur_id, sent_at], map: "idx_user_sent")
  @@index([to, sent_at], map: "idx_to_sent")
  @@index([status, sent_at], map: "idx_status_sent")
  @@index([sent_at], map: "idx_sent_at")
  @@map("emails")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
  DELIVERED
}

// ============================================================================
// ARTICLES - Boutique
// ============================================================================

model articles {
  id           Int            @id @default(autoincrement())
  nom          String         @db.VarChar(100)
  description  String?        @db.Text
  prix         Decimal        @db.Decimal(10, 2)
  image_url    String?        @db.VarChar(255)
  categorie_id Int?

  categories        categories?         @relation(fields: [categorie_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "articles_ibfk_1")
  commande_articles commande_articles[]
  images            images[]
  article_stock     ArticleStock[]

  @@index([categorie_id], map: "categorie_id")
  @@index([categorie_id, prix], map: "idx_categorie_prix")
  @@index([nom], map: "idx_nom")
}

// ============================================================================
// STOCK - Table unifiée (remplace stocks et articles_tailles)
// ============================================================================

model ArticleStock {
  id                   Int       @id @default(autoincrement())
  article_id           Int
  taille_id            Int
  quantity_total       Int       @default(0)
  quantity_reserved    Int       @default(0)
  quantity_available   Int       @default(0)
  last_restock_at      DateTime? @db.DateTime(0)
  low_stock_threshold  Int       @default(5)
  created_at           DateTime  @default(now()) @db.Timestamp(0)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamp(0)

  article articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  taille  tailles  @relation(fields: [taille_id], references: [id], onDelete: Cascade)

  @@unique([article_id, taille_id], map: "uk_article_taille")
  @@index([article_id, quantity_available], map: "idx_article_available")
  @@index([taille_id], map: "idx_taille")
  @@map("article_stock")
}

// ============================================================================
// COMMANDES
// ============================================================================

model commandes {
  id                          Int                           @id @default(autoincrement())
  unique_id                   String?                       @db.VarChar(255)
  numero_commande             String?                       @db.VarChar(100)
  utilisateur_id              Int
  total                       Decimal                       @default(0.00) @db.Decimal(10, 2)
  date_commande               DateTime                      @default(now()) @db.Timestamp(0)
  statut                      commandes_statut?             @default(en_attente)
  ip_address                  String?                       @db.VarChar(45)
  user_agent                  String?                       @db.Text
  created_at                  DateTime                      @default(now()) @db.Timestamp(0)

  commande_articles           commande_articles[]
  historique_statuts_commande historique_statuts_commande[]
  users                       utilisateurs                  @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "commandes_ibfk_1")
  paiements                   paiements[]

  @@index([created_at], map: "idx_created_at")
  @@index([numero_commande], map: "idx_numero_commande")
  @@index([total], map: "idx_total")
  @@index([unique_id], map: "idx_unique_id")
  @@index([utilisateur_id, statut], map: "idx_utilisateur_statut")
  @@index([statut, date_commande, total], map: "idx_statut_date_total")
  @@index([created_at, statut], map: "idx_created_statut")
}

model historique_statuts_commande {
  id              Int              @id @default(autoincrement())
  commande_id     Int
  ancien_statut   commandes_statut
  nouveau_statut  commandes_statut
  date_changement DateTime         @default(now()) @db.Timestamp(0)

  commandes commandes @relation(fields: [commande_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "historique_statuts_commande_ibfk_1")

  @@index([commande_id], map: "idx_commande_id")
  @@index([date_changement], map: "idx_date_changement")
}

// ============================================================================
// COURS
// ============================================================================

model cours {
  id                 Int             @id @default(autoincrement())
  sport_id           Int?
  date_cours         DateTime        @db.Date
  type_cours         String          @db.VarChar(50)
  heure_debut        DateTime        @db.Time(0)
  heure_fin          DateTime        @db.Time(0)
  cours_recurrent_id Int

  cours_recurrent cours_recurrent @relation(fields: [cours_recurrent_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cours_ibfk_1")
  sport           Sport?          @relation(fields: [sport_id], references: [id], onDelete: SetNull, map: "fk_cours_sport")
  inscriptions    inscriptions[]
  reservations    reservations[]

  @@index([cours_recurrent_id], map: "cours_recurrent_id")
  @@index([sport_id], map: "idx_cours_sport")
  @@index([date_cours, type_cours], map: "idx_date_type")
  @@index([date_cours, type_cours, cours_recurrent_id], map: "idx_date_type_recurrent")
  @@index([sport_id, date_cours], map: "idx_cours_sport_date")
  @@index([sport_id, date_cours, heure_debut], map: "idx_cours_planning")
  @@index([date_cours], map: "idx_cours_date")
}

model cours_recurrent {
  id                         Int                          @id @default(autoincrement())
  type_cours                 String?                      @db.VarChar(255)
  course_type_id             Int
  jour_semaine               Int
  heure_debut                DateTime                     @db.Time(0)
  heure_fin                  DateTime                     @db.Time(0)
  places_max                 Int?
  active                     Boolean?                     @default(true)

  course_type                CourseType                   @relation(fields: [course_type_id], references: [id], onDelete: Restrict, map: "fk_cours_recurrent_course_type")
  cours                      cours[]
  cours_recurrent_professeur cours_recurrent_professeur[]

  @@index([jour_semaine, type_cours], map: "idx_jour_type")
  @@index([course_type_id], map: "idx_course_type")
}

model cours_recurrent_professeur {
  id                 Int             @id @default(autoincrement())
  cours_recurrent_id Int
  professeur_id      Int

  cours_recurrent cours_recurrent @relation(fields: [cours_recurrent_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cours_recurrent_professeur_ibfk_1")
  professeurs     professeurs     @relation(fields: [professeur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cours_recurrent_professeur_ibfk_2")

  @@unique([cours_recurrent_id, professeur_id], map: "uk_cours_professeur")
  @@index([cours_recurrent_id, professeur_id], map: "idx_cours_professeur")
  @@index([professeur_id], map: "professeur_id")
}

// ============================================================================
// PAIEMENTS
// ============================================================================

model paiements {
  id                       Int              @id @default(autoincrement())
  commande_id              Int?
  utilisateur_id           Int
  montant                  Decimal          @db.Decimal(10, 2)
  methode_paiement         String?          @db.VarChar(50)
  payment_method_id        Int
  stripe_payment_intent_id String?          @db.VarChar(255)
  paypal_order_id          String?          @db.VarChar(255)
  bitcoin_address          String?          @db.VarChar(255)
  date_paiement            DateTime         @db.Date
  statut                   String?          @default("en_attente") @db.VarChar(50)
  description              String?          @db.Text
  date_confirmation        DateTime?        @db.Timestamp(0)
  date_modification        DateTime?        @default(now()) @db.Timestamp(0)
  abonnement_id            Int?
  periode_debut            DateTime?        @db.Date
  periode_fin              DateTime?        @db.Date

  payment_method   PaymentMethod     @relation(fields: [payment_method_id], references: [id], onDelete: Restrict, map: "fk_paiements_payment_method")
  users            utilisateurs      @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "paiements_ibfk_1")
  plans_tarifaires plans_tarifaires? @relation(fields: [abonnement_id], references: [id], onUpdate: Restrict, map: "paiements_ibfk_2")
  commandes        commandes?        @relation(fields: [commande_id], references: [id], onUpdate: Restrict, map: "paiements_ibfk_3")

  @@unique([utilisateur_id, periode_debut, abonnement_id], map: "uk_utilisateur_periode_abonnement")
  @@index([abonnement_id], map: "abonnement_id")
  @@index([commande_id], map: "idx_commande_id")
  @@index([methode_paiement], map: "idx_methode_paiement")
  @@index([payment_method_id], map: "idx_payment_method")
  @@index([paypal_order_id], map: "idx_paypal_order_id")
  @@index([stripe_payment_intent_id], map: "idx_stripe_payment_intent_id")
  @@index([utilisateur_id, statut], map: "idx_utilisateur_statut")
  @@index([date_paiement, statut, montant], map: "idx_date_statut_montant")
  @@index([utilisateur_id, date_paiement], map: "idx_user_date")
  @@index([date_paiement], map: "idx_paiements_date")
  @@index([utilisateur_id, date_paiement], map: "idx_paiements_user_date")
  @@index([utilisateur_id, date_paiement, montant], map: "idx_paiements_user_period")
}

model echeances_paiements {
  id               Int                         @id @default(autoincrement())
  utilisateur_id   Int
  abonnement_id    Int
  date_echeance    DateTime                    @db.Date
  montant          Decimal                     @db.Decimal(10, 2)
  statut           echeances_paiements_statut? @default(en_attente)
  date_paiement    DateTime?                   @db.Date

  utilisateurs     utilisateurs     @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "echeances_paiements_ibfk_1")
  plans_tarifaires plans_tarifaires @relation(fields: [abonnement_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "echeances_paiements_ibfk_2")

  @@index([abonnement_id, date_echeance], map: "idx_abonnement_echeance")
  @@index([utilisateur_id, date_echeance], map: "idx_utilisateur_echeance")
  @@index([statut, date_echeance], map: "idx_statut_date")
}

// ============================================================================
// MESSAGERIE
// ============================================================================

model messages {
  id                                              Int              @id @default(autoincrement())
  sender_id                                       Int
  receiver_id                                     Int?
  groupe_id                                       Int?
  contenu                                         String           @db.Text
  created_at                                      DateTime         @default(now()) @db.Timestamp(0)

  message_status                                  message_status[]
  utilisateurs_messages_sender_idToutilisateurs   utilisateurs     @relation("messages_sender_idToutilisateurs", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "messages_ibfk_1")
  utilisateurs_messages_receiver_idToutilisateurs utilisateurs?    @relation("messages_receiver_idToutilisateurs", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "messages_ibfk_2")
  groupes                                         groupes?         @relation(fields: [groupe_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "messages_ibfk_3")
  notifications                                   notifications[]

  @@index([groupe_id], map: "groupe_id")
  @@index([sender_id, receiver_id], map: "idx_sender_receiver")
  @@index([receiver_id], map: "receiver_id")
}

model messages_personnalises {
  id                                                               Int                                  @id @default(autoincrement())
  utilisateur_id                                                   Int
  contenu                                                          String                               @db.Text
  created_at                                                       DateTime                             @default(now()) @db.Timestamp(0)
  deleted_at                                                       DateTime?                            @db.DateTime(0)
  deleted_by                                                       Int?
  is_active                                                        Boolean?                             @default(true)
  lu                                                               Boolean?                             @default(false)
  date_lecture                                                     DateTime?                            @db.DateTime(0)
  status_envoi                                                     messages_personnalises_status_envoi? @default(pending)
  sendgrid_message_id                                              String?                              @db.VarChar(255)
  error_details                                                    String?                              @db.Text
  updated_at                                                       DateTime                             @default(now()) @db.Timestamp(0)

  utilisateurs_messages_personnalises_utilisateur_idToutilisateurs utilisateurs  @relation("messages_personnalises_utilisateur_idToutilisateurs", fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "messages_personnalises_ibfk_1")
  utilisateurs_messages_personnalises_deleted_byToutilisateurs     utilisateurs? @relation("messages_personnalises_deleted_byToutilisateurs", fields: [deleted_by], references: [id], onUpdate: Restrict, map: "messages_personnalises_ibfk_2")

  @@index([deleted_by], map: "deleted_by")
  @@index([utilisateur_id, is_active], map: "idx_messages_personnalises_active")
  @@index([date_lecture], map: "idx_messages_personnalises_date_lecture")
  @@index([utilisateur_id, deleted_at], map: "idx_messages_personnalises_deleted")
  @@index([utilisateur_id, lu], map: "idx_messages_personnalises_lu")
  @@index([sendgrid_message_id], map: "idx_messages_personnalises_sendgrid_id")
  @@index([status_envoi], map: "idx_messages_personnalises_status_envoi")
  @@index([utilisateur_id, status_envoi, created_at], map: "idx_user_status_date")
  @@index([updated_at], map: "idx_messages_personnalises_updated")
  @@index([utilisateur_id], map: "idx_utilisateur")
}

// ============================================================================
// UTILISATEURS
// ============================================================================

model utilisateurs {
  id                                                                             Int                        @id @default(autoincrement())
  user_id                                                                        String                     @unique(map: "unique_user_id") @db.VarChar(20)
  user_sports                                                                    UserSport[]
  grade_history                                                                  UserGradeHistory[]
  examined_grades                                                                UserGradeHistory[]         @relation("GradeExaminer")
  sport_statistics                                                               SportStatistic[]
  first_name                                                                     String                     @db.VarChar(50)
  last_name                                                                      String                     @db.VarChar(50)
  nom_utilisateur                                                                String                     @db.VarChar(50)
  email                                                                          String                     @db.VarChar(100)
  genre_id                                                                       Int?
  date_of_birth                                                                  DateTime                   @db.Date

  // DEPRECATED - Use new tables instead
  password                                                                       String                     @db.VarChar(255) // DEPRECATED: Use user_security.password
  status_id                                                                      Int?                       @default(1) // DEPRECATED: Use user_subscriptions.status_id
  active                                                                         Boolean                    @default(true)
  grade_id                                                                       Int?                       @default(1) // DEPRECATED: Use user_profiles.grade_id
  abonnement_id                                                                  Int?                       // DEPRECATED: Use user_subscriptions.abonnement_id
  stripe_customer_id                                                             String?                    @unique(map: "unique_stripe_customer_id") @db.VarChar(255) // DEPRECATED: Use user_subscriptions.stripe_customer_id
  stripe_subscription_id                                                         String?                    @db.VarChar(255) // DEPRECATED: Use user_subscriptions.stripe_subscription_id
  date_inscription                                                               DateTime                   @default(now()) @db.Timestamp(0)
  email_verified                                                                 Boolean?                   @default(false) // DEPRECATED: Use user_security.email_verified
  email_verified_at                                                              DateTime?                  @db.Timestamp(0) // DEPRECATED: Use user_security.email_verified_at

  // Soft delete - Phase 2
  deleted_at                                                                     DateTime?                  @db.Timestamp(0)
  deleted_by                                                                     Int?
  deletion_reason                                                                String?                    @db.Text

  // Phase 2 - New relations
  user_profile                                                                   UserProfile?
  user_security                                                                  UserSecurity?
  user_subscription                                                              UserSubscription?
  user_preferences                                                               UserPreferences?
  user_consents                                                                  UserConsent[]
  data_export_requests                                                           DataExportRequest[]
  account_deletion_requests                                                      AccountDeletionRequest[]   @relation("account_deletion_user")
  approved_deletions                                                             AccountDeletionRequest[]   @relation("account_deletion_approver")

  // Existing relations
  alertes_actions                                                                alertes_actions[]
  alertes_utilisateurs                                                           alertes_utilisateurs[]
  alertes_utilisateurs_alertes_utilisateurs_resolu_parToutilisateurs             alertes_utilisateurs[]     @relation("alertes_utilisateurs_resolu_parToutilisateurs")
  commandes                                                                      commandes[]
  echeances_paiements                                                            echeances_paiements[]
  email_validation_tokens                                                        email_validation_tokens[]
  groupes_utilisateurs                                                           groupes_utilisateurs[]
  inscriptions                                                                   inscriptions[]
  manual_recovery_requests_manual_recovery_requests_utilisateur_idToutilisateurs manual_recovery_requests[] @relation("manual_recovery_requests_utilisateur_idToutilisateurs")
  manual_recovery_requests_manual_recovery_requests_processed_byToutilisateurs   manual_recovery_requests[] @relation("manual_recovery_requests_processed_byToutilisateurs")
  message_status                                                                 message_status[]
  messages_messages_sender_idToutilisateurs                                      messages[]                 @relation("messages_sender_idToutilisateurs")
  messages_messages_receiver_idToutilisateurs                                    messages[]                 @relation("messages_receiver_idToutilisateurs")
  messages_personnalises_messages_personnalises_utilisateur_idToutilisateurs     messages_personnalises[]   @relation("messages_personnalises_utilisateur_idToutilisateurs")
  messages_personnalises_messages_personnalises_deleted_byToutilisateurs         messages_personnalises[]   @relation("messages_personnalises_deleted_byToutilisateurs")
  notifications                                                                  notifications[]
  paiements                                                                      paiements[]
  password_reset_tokens                                                          password_reset_tokens[]
  refresh_tokens                                                                 refresh_tokens[]
  reservations                                                                   reservations[]
  sms_recovery_codes                                                             sms_recovery_codes[]
  sessions                                                                       Session[]
  audit_logs                                                                     AuditLog[]
  emails                                                                         Email[]
  emailQueue                                                                     EmailQueue[]
  genres                                                                         genres?                    @relation(fields: [genre_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "utilisateurs_ibfk_1")
  status                                                                         status?                    @relation(fields: [status_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "utilisateurs_ibfk_2")
  grades                                                                         grades?                    @relation(fields: [grade_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "utilisateurs_ibfk_3")
  plans_tarifaires                                                               plans_tarifaires?          @relation(fields: [abonnement_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "utilisateurs_ibfk_4")

  @@index([abonnement_id], map: "abonnement_id")
  @@index([genre_id], map: "genre_id")
  @@index([grade_id], map: "grade_id")
  @@index([active], map: "idx_active")
  @@index([active, status_id], map: "idx_active_status")
  @@index([email], map: "idx_email")
  @@index([email_verified], map: "idx_email_verified")
  @@index([nom_utilisateur], map: "idx_nom_utilisateur")
  @@index([last_name, first_name, date_of_birth], map: "idx_person_lookup")
  @@index([status_id], map: "idx_status")
  @@index([stripe_customer_id], map: "idx_stripe_customer_id")
  @@index([stripe_subscription_id], map: "idx_stripe_subscription_id")
  @@index([deleted_at], map: "idx_deleted_at")
  @@index([deleted_at], map: "idx_users_deleted_at")
  @@index([email, deleted_at], map: "idx_users_email_active")
}

// ============================================================================
// PHASE 2 - USER SPLIT TABLES
// ============================================================================

model UserProfile {
  id                      Int       @id @default(autoincrement())
  user_id                 Int       @unique
  grade_id                Int?
  bio                     String?   @db.Text
  avatar_url              String?   @db.VarChar(500)
  phone                   String?   @db.VarChar(20)
  emergency_contact_name  String?   @db.VarChar(100)
  emergency_contact_phone String?   @db.VarChar(20)
  created_at              DateTime  @default(now()) @db.Timestamp(0)
  updated_at              DateTime  @updatedAt @db.Timestamp(0)

  user                    utilisateurs @relation(fields: [user_id], references: [id], onDelete: Cascade)
  grade                   grades?      @relation(fields: [grade_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "idx_user_id")
  @@index([grade_id], map: "idx_grade_id")
  @@map("user_profiles")
}

model UserSecurity {
  id                     Int       @id @default(autoincrement())
  user_id                Int       @unique
  password               String    @db.VarChar(255)
  email_verified         Boolean   @default(false)
  email_verified_at      DateTime? @db.Timestamp(0)
  last_login_at          DateTime? @db.Timestamp(0)
  failed_login_attempts  Int       @default(0)
  locked_until           DateTime? @db.Timestamp(0)
  two_factor_enabled     Boolean   @default(false)
  two_factor_secret      String?   @db.VarChar(255)
  password_changed_at    DateTime? @db.Timestamp(0)
  created_at             DateTime  @default(now()) @db.Timestamp(0)
  updated_at             DateTime  @updatedAt @db.Timestamp(0)

  user                   utilisateurs @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_id")
  @@index([email_verified], map: "idx_email_verified")
  @@index([locked_until], map: "idx_locked_until")
  @@index([last_login_at], map: "idx_last_login")
  @@map("user_security")
}

model UserSubscription {
  id                     Int       @id @default(autoincrement())
  user_id                Int       @unique
  abonnement_id          Int?
  status_id              Int?      @default(1)
  stripe_customer_id     String?   @unique @db.VarChar(255)
  stripe_subscription_id String?   @db.VarChar(255)
  subscription_start_at  DateTime? @db.Timestamp(0)
  subscription_end_at    DateTime? @db.Timestamp(0)
  auto_renew             Boolean   @default(true)
  cancellation_reason    String?   @db.Text
  cancelled_at           DateTime? @db.Timestamp(0)
  created_at             DateTime  @default(now()) @db.Timestamp(0)
  updated_at             DateTime  @updatedAt @db.Timestamp(0)

  user                   utilisateurs      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan                   plans_tarifaires? @relation(fields: [abonnement_id], references: [id], onDelete: SetNull)
  status                 status?           @relation(fields: [status_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "idx_user_id")
  @@index([abonnement_id], map: "idx_abonnement_id")
  @@index([status_id], map: "idx_status_id")
  @@index([stripe_customer_id], map: "idx_stripe_customer")
  @@index([stripe_subscription_id], map: "idx_stripe_subscription")
  @@index([subscription_end_at], map: "idx_subscription_end")
  @@map("user_subscriptions")
}

model UserPreferences {
  id                  Int      @id @default(autoincrement())
  user_id             Int      @unique
  language            String   @default("fr") @db.VarChar(10)
  timezone            String   @default("Europe/Brussels") @db.VarChar(50)
  notifications_email Boolean  @default(true)
  notifications_sms   Boolean  @default(false)
  notifications_push  Boolean  @default(true)
  theme               String   @default("light") @db.VarChar(20)
  date_format         String   @default("DD/MM/YYYY") @db.VarChar(20)
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @updatedAt @db.Timestamp(0)

  user                utilisateurs @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_id")
  @@index([language], map: "idx_language")
  @@map("user_preferences")
}

// ============================================================================
// PHASE 2 - GDPR TABLES
// ============================================================================

model UserConsent {
  id           Int                @id @default(autoincrement())
  user_id      Int
  consent_type UserConsentType
  given        Boolean            @default(false)
  ip_address   String?            @db.VarChar(45)
  user_agent   String?            @db.Text
  given_at     DateTime           @default(now()) @db.Timestamp(0)
  revoked_at   DateTime?          @db.Timestamp(0)
  version      String?            @db.VarChar(20)

  user         utilisateurs       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_id")
  @@index([consent_type], map: "idx_consent_type")
  @@index([given], map: "idx_given")
  @@index([user_id, consent_type, given], map: "idx_user_consent")
  @@index([given_at], map: "idx_given_at")
  @@map("user_consents")
}

enum UserConsentType {
  MARKETING
  ANALYTICS
  TERMS
  PRIVACY
  DATA_PROCESSING
}

model DataExportRequest {
  id                    Int                    @id @default(autoincrement())
  user_id               Int
  status                DataExportStatus       @default(PENDING)
  requested_at          DateTime               @default(now()) @db.Timestamp(0)
  processing_started_at DateTime?              @db.Timestamp(0)
  completed_at          DateTime?              @db.Timestamp(0)
  expires_at            DateTime?              @db.Timestamp(0)
  file_path             String?                @db.VarChar(500)
  file_size_bytes       BigInt?
  request_ip            String?                @db.VarChar(45)
  download_count        Int                    @default(0)
  last_downloaded_at    DateTime?              @db.Timestamp(0)
  error_message         String?                @db.Text

  user                  utilisateurs           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_id")
  @@index([status], map: "idx_status")
  @@index([expires_at], map: "idx_expires_at")
  @@index([requested_at], map: "idx_requested_at")
  @@map("data_export_requests")
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model AccountDeletionRequest {
  id               Int                      @id @default(autoincrement())
  user_id          Int
  status           AccountDeletionStatus    @default(PENDING)
  reason           String?                  @db.Text
  requested_at     DateTime                 @default(now()) @db.Timestamp(0)
  approved_at      DateTime?                @db.Timestamp(0)
  approved_by      Int?
  completed_at     DateTime?                @db.Timestamp(0)
  rejection_reason String?                  @db.Text
  request_ip       String?                  @db.VarChar(45)

  user             utilisateurs             @relation("account_deletion_user", fields: [user_id], references: [id], onDelete: Cascade)
  approver         utilisateurs?            @relation("account_deletion_approver", fields: [approved_by], references: [id], onDelete: SetNull)

  @@index([user_id], map: "idx_user_id")
  @@index([status], map: "idx_status")
  @@index([requested_at], map: "idx_requested_at")
  @@index([approved_by], map: "idx_approved_by")
  @@map("account_deletion_requests")
}

enum AccountDeletionStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

// ============================================================================
// AUTRES TABLES (sans modifications Phase 1)
// ============================================================================

model genres {
  id           Int            @id @default(autoincrement())
  genre_name   String         @unique(map: "genre_name") @db.VarChar(50)
  utilisateurs utilisateurs[]
}

model grades {
  id            Int            @id @default(autoincrement())
  grade_id      String         @unique(map: "grade_id") @db.VarChar(100)
  nom           String?        @db.VarChar(100)
  couleur       String?        @db.VarChar(7)
  ordre         Int            @default(0)
  description   String?        @db.Text
  sport_id      Int?
  created_at    DateTime?      @default(now()) @db.Timestamp(0)
  updated_at    DateTime?      @default(now()) @updatedAt @db.Timestamp(0)

  professeurs   professeurs[]
  utilisateurs  utilisateurs[]
  user_profiles UserProfile[]
  sport         Sport?         @relation(fields: [sport_id], references: [id], onDelete: Cascade, map: "fk_grades_sport")
  user_sports   UserSport[]    @relation("UserSportCurrentGrade")
  grade_history UserGradeHistory[]

  @@index([sport_id], map: "idx_grades_sport")
  @@index([sport_id, ordre], map: "idx_grades_sport_order")
}

model groupes {
  id                   Int                    @id @default(autoincrement())
  nom                  String                 @db.VarChar(100)
  description          String?                @db.Text
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  groupes_utilisateurs groupes_utilisateurs[]
  messages             messages[]

  @@index([nom], map: "idx_nom")
}

model groupes_utilisateurs {
  id             Int          @id @default(autoincrement())
  groupe_id      Int
  utilisateur_id Int
  date_ajout     DateTime     @default(now()) @db.Timestamp(0)
  groupes        groupes      @relation(fields: [groupe_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "groupes_utilisateurs_ibfk_1")
  users          utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "groupes_utilisateurs_ibfk_2")

  @@unique([groupe_id, utilisateur_id], map: "uk_groupe_utilisateur")
  @@index([groupe_id, utilisateur_id], map: "idx_groupe_utilisateur")
  @@index([utilisateur_id], map: "utilisateur_id")
}

model inscriptions {
  id               Int          @id @default(autoincrement())
  utilisateur_id   Int
  cours_id         Int
  date_inscription DateTime     @default(now()) @db.Timestamp(0)
  status_id        Boolean?
  users            utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inscriptions_ibfk_1")
  cours            cours        @relation(fields: [cours_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inscriptions_ibfk_2")

  @@unique([utilisateur_id, cours_id], map: "uk_utilisateur_cours")
  @@index([cours_id], map: "cours_id")
  @@index([utilisateur_id, cours_id], map: "idx_utilisateur_cours")
  @@index([cours_id, status_id], map: "idx_cours_status")
  @@index([cours_id, utilisateur_id], map: "idx_inscriptions_cours")
  @@index([utilisateur_id, date_inscription], map: "idx_inscriptions_user_date")
}

model notifications {
  id             Int          @id @default(autoincrement())
  utilisateur_id Int
  message_id     Int
  vu             Boolean?     @default(false)
  created_at     DateTime     @default(now()) @db.Timestamp(0)
  users          utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_ibfk_1")
  messages       messages     @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_ibfk_2")

  @@index([utilisateur_id, vu], map: "idx_utilisateur_vu")
  @@index([message_id], map: "message_id")
}

model password_reset_tokens {
  id             Int          @id @default(autoincrement())
  utilisateur_id Int
  token          String       @unique(map: "token") @db.VarChar(64)
  expires_at     DateTime     @default(now()) @db.Timestamp(0)
  created_at     DateTime     @default(now()) @db.Timestamp(0)
  used_at        DateTime?    @db.Timestamp(0)
  utilisateurs   utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "password_reset_tokens_ibfk_1")

  @@index([expires_at], map: "idx_expires_at")
  @@index([token], map: "idx_token")
  @@index([utilisateur_id], map: "idx_utilisateur_id")
}

model plans_tarifaires {
  id                  Int                   @id @default(autoincrement())
  nom_plan            String                @unique(map: "nom_plan") @db.VarChar(50)
  prix                Decimal               @db.Decimal(10, 2)
  periode             String                @db.VarChar(20)
  description         String?               @db.Text
  echeances_paiements echeances_paiements[]
  paiements           paiements[]
  utilisateurs        utilisateurs[]
  user_subscriptions  UserSubscription[]
}

model reservations {
  id             Int          @id @default(autoincrement())
  utilisateur_id Int
  cours_id       Int
  users          utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reservations_ibfk_1")
  cours          cours        @relation(fields: [cours_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reservations_ibfk_2")

  @@unique([utilisateur_id, cours_id], map: "uk_utilisateur_cours")
  @@index([cours_id], map: "cours_id")
  @@index([utilisateur_id, cours_id], map: "idx_utilisateur_cours")
}

model status {
  id                 Int                @id @default(autoincrement())
  nom_role           String             @unique(map: "nom_role") @db.VarChar(50)
  description        String?            @db.Text
  professeurs        professeurs[]
  utilisateurs       utilisateurs[]
  user_subscriptions UserSubscription[]
}

model tailles {
  id                Int                 @id @default(autoincrement())
  nom               String              @unique(map: "nom") @db.VarChar(20)
  commande_articles commande_articles[]
  article_stock     ArticleStock[]
}

model categories {
  id          Int              @id @default(autoincrement())
  nom         String           @unique(map: "nom") @db.VarChar(100)
  sport_id    Int?
  description String?          @db.Text
  articles    articles[]
  sport       Sport?           @relation(fields: [sport_id], references: [id], onDelete: SetNull, map: "fk_categories_sport")
  equipment   SportEquipment[]

  @@index([sport_id], map: "idx_categories_sport")
}

model commande_articles {
  id          Int       @id @default(autoincrement())
  commande_id Int
  article_id  Int
  taille_id   Int
  quantite    Int
  prix        Decimal   @db.Decimal(10, 2)
  commandes   commandes @relation(fields: [commande_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "commande_articles_ibfk_1")
  articles    articles  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "commande_articles_ibfk_2")
  tailles     tailles   @relation(fields: [taille_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "commande_articles_ibfk_3")

  @@index([article_id], map: "article_id")
  @@index([commande_id, article_id], map: "idx_commande_article")
  @@index([taille_id], map: "taille_id")
}

model email_validation_tokens {
  id             Int                          @id @default(autoincrement())
  utilisateur_id Int
  token          String                       @unique(map: "token") @db.VarChar(255)
  type           email_validation_tokens_type
  expires_at     DateTime                     @default(now()) @db.Timestamp(0)
  used           Boolean?                     @default(false)
  created_at     DateTime                     @default(now()) @db.Timestamp(0)
  utilisateurs   utilisateurs                 @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "email_validation_tokens_ibfk_1")

  @@index([expires_at], map: "idx_expires")
  @@index([token], map: "idx_token")
  @@index([utilisateur_id, type], map: "idx_utilisateur_type")
}

model images {
  id         Int      @id @default(autoincrement())
  article_id Int
  url        String   @db.Text
  is_main    Boolean? @default(false)
  articles   articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "images_ibfk_1")

  @@index([article_id], map: "idx_article")
}

model manual_recovery_requests {
  id                                                                 Int                              @id @default(autoincrement())
  utilisateur_id                                                     Int
  reason                                                             String                           @db.Text
  verification_data                                                  String?                          @db.LongText
  status                                                             manual_recovery_requests_status? @default(pending)
  admin_notes                                                        String?                          @db.Text
  processed_by                                                       Int?
  processed_at                                                       DateTime?                        @db.Timestamp(0)
  created_at                                                         DateTime                         @default(now()) @db.Timestamp(0)
  expires_at                                                         DateTime?                        @db.Timestamp(0)
  utilisateurs_manual_recovery_requests_utilisateur_idToutilisateurs utilisateurs                     @relation("manual_recovery_requests_utilisateur_idToutilisateurs", fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "manual_recovery_requests_ibfk_1")
  utilisateurs_manual_recovery_requests_processed_byToutilisateurs   utilisateurs?                    @relation("manual_recovery_requests_processed_byToutilisateurs", fields: [processed_by], references: [id], onUpdate: Restrict, map: "manual_recovery_requests_ibfk_2")

  @@index([created_at], map: "idx_created_at")
  @@index([expires_at], map: "idx_expires_at")
  @@index([utilisateur_id, status], map: "idx_utilisateur_status")
  @@index([processed_by], map: "processed_by")
}

model message_status {
  id             Int                    @id @default(autoincrement())
  message_id     Int
  utilisateur_id Int
  status         message_status_status? @default(non_vu)
  updated_at     DateTime               @default(now()) @db.Timestamp(0)
  messages       messages               @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "message_status_ibfk_1")
  utilisateurs   utilisateurs           @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "message_status_ibfk_2")

  @@unique([message_id, utilisateur_id], map: "uk_message_utilisateur")
  @@index([message_id, utilisateur_id], map: "idx_message_utilisateur")
  @@index([utilisateur_id], map: "utilisateur_id")
}

model auth_attempts {
  id           Int      @id @default(autoincrement())
  email        String   @db.VarChar(255)
  ip_address   String?  @db.VarChar(45)
  user_agent   String?  @db.Text
  success      Boolean  @default(false)
  attempted_at DateTime @default(now()) @db.Timestamp(0)

  @@index([email, attempted_at], map: "idx_auth_email_time")
  @@index([ip_address, attempted_at], map: "idx_auth_ip_time")
}

model refresh_tokens {
  id             Int          @id @default(autoincrement())
  utilisateur_id Int
  token          String       @unique(map: "refresh_token") @db.VarChar(255)
  expires_at     DateTime     @db.Timestamp(0)
  created_at     DateTime     @default(now()) @db.Timestamp(0)
  revoked_at     DateTime?    @db.Timestamp(0)
  replaced_by    String?      @db.VarChar(255)
  ip_address     String?      @db.VarChar(45)
  user_agent     String?      @db.Text
  utilisateurs   utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "refresh_tokens_ibfk_1")

  @@index([utilisateur_id], map: "idx_refresh_user_id")
  @@index([token], map: "idx_refresh_token")
  @@index([expires_at], map: "idx_refresh_expires")
}

model password_reset_attempts {
  id           Int      @id @default(autoincrement())
  email        String   @db.VarChar(255)
  ip_address   String?  @db.VarChar(45)
  user_agent   String?  @db.Text
  success      Boolean? @default(false)
  attempted_at DateTime @default(now()) @db.Timestamp(0)

  @@index([email, attempted_at], map: "idx_email_time")
  @@index([ip_address, attempted_at], map: "idx_ip_time")
}

model professeurs {
  id                         Int                          @id @default(autoincrement())
  nom                        String                       @db.VarChar(255)
  prenom                     String                       @db.VarChar(255)
  email                      String?                      @unique(map: "email") @db.VarChar(255)
  grade_id                   Int?
  status_id                  Int?
  cours_recurrent_professeur cours_recurrent_professeur[]
  grades                     grades?                      @relation(fields: [grade_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "professeurs_ibfk_1")
  status                     status?                      @relation(fields: [status_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "professeurs_ibfk_2")

  @@index([grade_id], map: "grade_id")
  @@index([email], map: "idx_email")
  @@index([status_id], map: "status_id")
}

model sms_recovery_codes {
  id             Int          @id @default(autoincrement())
  utilisateur_id Int
  phone          String       @db.VarChar(20)
  code           String       @db.VarChar(6)
  attempts       Int?         @default(0)
  expires_at     DateTime     @default(now()) @db.Timestamp(0)
  created_at     DateTime     @default(now()) @db.Timestamp(0)
  used_at        DateTime?    @db.Timestamp(0)
  utilisateurs   utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sms_recovery_codes_ibfk_1")

  @@unique([utilisateur_id, phone], map: "unique_utilisateur_phone")
  @@index([expires_at], map: "idx_expires_at")
  @@index([phone, code], map: "idx_phone_code")
}

model statistiques {
  id               Int      @id @default(autoincrement())
  type_statistique String   @db.VarChar(50)
  periode_debut    DateTime @db.Date
  periode_fin      DateTime @db.Date
  valeur           Decimal? @db.Decimal(10, 2)
  description      String?  @db.Text
  date_creation    DateTime @default(now()) @db.Timestamp(0)

  @@index([type_statistique, periode_debut, periode_fin], map: "idx_type_periode")
}

model types_messages_personnalises {
  id         Int      @id @default(autoincrement())
  title      String   @unique(map: "title") @db.VarChar(255)
  content    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

model validation_tokens {
  id             Int                     @id @default(autoincrement())
  utilisateur_id Int
  token          String                  @unique(map: "token") @db.VarChar(255)
  user_id_string String?                 @db.VarChar(50)
  token_hash     String?                 @db.VarChar(64)
  type           validation_tokens_type? @default(email_confirmation)
  expires_at     DateTime                @default(now()) @db.Timestamp(0)
  used           Boolean?                @default(false)
  used_at        DateTime?               @db.Timestamp(0)
  created_at     DateTime                @default(now()) @db.Timestamp(0)

  @@index([token], map: "idx_token")
  @@index([token_hash], map: "idx_token_hash")
  @@index([token, user_id_string], map: "idx_token_userid")
  @@index([user_id_string], map: "idx_user_id_string")
  @@index([utilisateur_id], map: "idx_utilisateur_id")
}

model alertes_actions {
  id                   Int                         @id @default(autoincrement())
  alerte_id            Int
  action_type          alertes_actions_action_type
  description          String?                     @db.Text
  effectue_par         Int?
  date_action          DateTime?                   @default(now()) @db.Timestamp(0)
  alertes_utilisateurs alertes_utilisateurs        @relation(fields: [alerte_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "alertes_actions_ibfk_1")
  utilisateurs         utilisateurs?               @relation(fields: [effectue_par], references: [id], onUpdate: Restrict, map: "alertes_actions_ibfk_2")

  @@index([effectue_par], map: "effectue_par")
  @@index([alerte_id, date_action], map: "idx_alerte_date")
}

model alertes_types {
  id                   Int                     @id @default(autoincrement())
  code                 String                  @unique(map: "code") @db.VarChar(50)
  nom                  String                  @db.VarChar(100)
  description          String?                 @db.Text
  priorite             alertes_types_priorite? @default(normale)
  actif                Boolean?                @default(true)
  created_at           DateTime?               @default(now()) @db.Timestamp(0)
  alertes_utilisateurs alertes_utilisateurs[]
}

model alertes_utilisateurs {
  id                                                         Int                          @id @default(autoincrement())
  utilisateur_id                                             Int
  alerte_type_id                                             Int
  statut                                                     alertes_utilisateurs_statut? @default(active)
  donnees_contexte                                           Json?
  date_detection                                             DateTime?                    @default(now()) @db.Timestamp(0)
  date_resolution                                            DateTime?                    @db.Timestamp(0)
  resolu_par                                                 Int?
  notes                                                      String?                      @db.Text
  alertes_actions                                            alertes_actions[]
  utilisateurs                                               utilisateurs                 @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "alertes_utilisateurs_ibfk_1")
  alertes_types                                              alertes_types                @relation(fields: [alerte_type_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "alertes_utilisateurs_ibfk_2")
  utilisateurs_alertes_utilisateurs_resolu_parToutilisateurs utilisateurs?                @relation("alertes_utilisateurs_resolu_parToutilisateurs", fields: [resolu_par], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "alertes_utilisateurs_ibfk_3")

  @@index([alerte_type_id, statut], map: "idx_type_statut")
  @@index([resolu_par], map: "resolu_par")
  @@index([utilisateur_id, statut], map: "idx_utilisateur_statut")
}

// ============================================================================
// ENUMS
// ============================================================================

enum email_validation_tokens_type {
  email_confirmation
  password_setup
}

enum message_status_status {
  vu
  non_vu @map("non vu")
}

enum manual_recovery_requests_status {
  pending
  approved
  rejected
  expired
}

enum echeances_paiements_statut {
  pay_       @map("payé")
  en_attente @map("en attente")
  chu        @map("échu")
}

enum validation_tokens_type {
  email_confirmation
  password_setup
}

enum commandes_statut {
  en_attente @map("en attente")
  pay_e      @map("payée")
  exp_di_e   @map("expédiée")
  annul_e    @map("annulée")
}

enum messages_personnalises_status_envoi {
  pending
  sent
  failed
  delivered
  bounced
}

enum alertes_actions_action_type {
  message_envoye
  information_mise_a_jour
  paiement_recu
  autre
}

enum alertes_utilisateurs_statut {
  active
  resolue
  ignoree
}

enum alertes_types_priorite {
  basse
  normale
  haute
  critique
}

// ============================================================================
// PHASE 5: MULTI-SPORTS SYSTEM
// ============================================================================

model Sport {
  id                      Int                       @id @default(autoincrement())
  code                    String                    @unique @db.VarChar(50)
  name                    String                    @db.VarChar(100)
  description             String?                   @db.Text
  color                   String                    @default("#3B82F6") @db.VarChar(7)
  icon                    String?                   @db.VarChar(100)
  image_url               String?                   @db.VarChar(255)
  is_active               Boolean                   @default(true)
  display_order           Int                       @default(0)
  requires_belt           Boolean                   @default(true)
  allow_competitions      Boolean                   @default(true)
  min_age                 Int?
  max_age                 Int?
  created_at              DateTime                  @default(now()) @db.Timestamp(0)
  updated_at              DateTime                  @default(now()) @updatedAt @db.Timestamp(0)

  // Relations
  configurations          SportConfiguration[]
  user_sports             UserSport[]
  grades                  grades[]
  courses                 cours[]
  course_types            CourseType[]
  categories              categories[]
  equipment               SportEquipment[]
  competition_rules       SportCompetitionRule[]
  statistics              SportStatistic[]
  grade_history           UserGradeHistory[]

  @@index([is_active], map: "idx_sports_active")
  @@index([display_order], map: "idx_sports_order")
  @@map("sports")
}

model SportConfiguration {
  id          Int      @id @default(autoincrement())
  sport_id    Int
  config_key  String   @db.VarChar(100)
  config_value String? @db.Text
  data_type   SportConfigDataType @default(string)
  description String?  @db.VarChar(255)
  is_public   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  sport       Sport    @relation(fields: [sport_id], references: [id], onDelete: Cascade)

  @@unique([sport_id, config_key], map: "unique_sport_config")
  @@index([sport_id, is_public], map: "idx_sport_configs_public")
  @@map("sport_configurations")
}

model UserSport {
  id               Int       @id @default(autoincrement())
  user_id          Int
  sport_id         Int
  current_grade_id Int?
  started_at       DateTime? @db.Date
  is_primary       Boolean   @default(false)
  is_active        Boolean   @default(true)
  notes            String?   @db.Text
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamp(0)

  user             utilisateurs @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sport            Sport        @relation(fields: [sport_id], references: [id], onDelete: Cascade)
  current_grade    grades?      @relation("UserSportCurrentGrade", fields: [current_grade_id], references: [id], onDelete: SetNull)

  @@unique([user_id, sport_id], map: "unique_user_sport")
  @@index([user_id, is_active], map: "idx_user_sports_active")
  @@index([user_id, is_primary], map: "idx_user_sports_primary")
  @@index([is_active, is_primary, sport_id], map: "idx_user_sports_active_primary")
  @@index([sport_id, is_active], map: "idx_user_sports_sport_active")
  @@index([sport_id, is_active, user_id], map: "idx_user_sports_lookup")
  @@map("user_sports")
}

model UserGradeHistory {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  sport_id            Int
  grade_id            Int
  obtained_at         DateTime  @db.Date
  examiner_id         Int?
  location            String?   @db.VarChar(255)
  certificate_number  String?   @db.VarChar(100)
  notes               String?   @db.Text
  created_at          DateTime  @default(now()) @db.Timestamp(0)

  user                utilisateurs @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sport               Sport        @relation(fields: [sport_id], references: [id], onDelete: Cascade)
  grade               grades       @relation(fields: [grade_id], references: [id], onDelete: Cascade)
  examiner            utilisateurs? @relation("GradeExaminer", fields: [examiner_id], references: [id], onDelete: SetNull)

  @@index([user_id, sport_id], map: "idx_grade_history_user")
  @@index([obtained_at], map: "idx_grade_history_date")
  @@index([user_id, sport_id, obtained_at], map: "idx_grade_history_composite")
  @@index([user_id, obtained_at], map: "idx_hist_grades_user_date")
  @@map("user_grade_history")
}

model SportEquipment {
  id            Int       @id @default(autoincrement())
  sport_id      Int
  name          String    @db.VarChar(100)
  description   String?   @db.Text
  is_mandatory  Boolean   @default(false)
  for_level     SportEquipmentLevel @default(all)
  category_id   Int?
  display_order Int       @default(0)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(0)

  sport         Sport        @relation(fields: [sport_id], references: [id], onDelete: Cascade)
  category      categories?  @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([sport_id], map: "idx_sport_equipment_sport")
  @@index([sport_id, is_mandatory], map: "idx_sport_equipment_mandatory")
  @@index([sport_id, for_level, is_mandatory], map: "idx_sport_equipment_level")
  @@map("sport_equipment")
}

model SportCompetitionRule {
  id            Int       @id @default(autoincrement())
  sport_id      Int
  rule_name     String    @db.VarChar(100)
  rule_type     CompetitionRuleType @default(other)
  description   String    @db.Text
  applies_to    String?   @db.VarChar(100)
  is_active     Boolean   @default(true)
  display_order Int       @default(0)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(0)

  sport         Sport     @relation(fields: [sport_id], references: [id], onDelete: Cascade)

  @@index([sport_id, is_active], map: "idx_competition_rules_sport")
  @@map("sport_competition_rules")
}

model SportStatistic {
  id                Int       @id @default(autoincrement())
  sport_id          Int
  user_id           Int?
  stat_date         DateTime  @db.Date
  total_members     Int       @default(0)
  total_courses     Int       @default(0)
  total_hours       Decimal   @default(0) @db.Decimal(10, 2)
  total_competitions Int      @default(0)
  total_revenue     Decimal   @default(0) @db.Decimal(10, 2)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamp(0)

  sport             Sport     @relation(fields: [sport_id], references: [id], onDelete: Cascade)
  user              utilisateurs? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([sport_id, user_id, stat_date], map: "unique_sport_stat")
  @@index([sport_id, stat_date], map: "idx_sport_stats_date")
  @@map("sport_statistics")
}



// Enums for Multi-Sports System
enum SportConfigDataType {
  string
  number
  boolean
  json
  text
}

enum SportEquipmentLevel {
  beginner
  intermediate
  advanced
  competition
  all
}

enum CompetitionRuleType {
  scoring
  time
  safety
  equipment
  category
  other
}
