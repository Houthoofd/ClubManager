/**
 * Resolvers GraphQL pour le module Auth
 * Utilise les services pour la logique métier
 * REFACTORÉ: Utilise middleware requireAuth et custom errors
 */

import { PrismaClient } from "@prisma/client";
import {
  authentifierUtilisateur,
  verifierTokenReset,
  demanderResetMotDePasse,
  envoyerEmailResetMotDePasse,
  reinitialiserMotDePasse,
  verifierTokenValidation,
  confirmerEmail,
  genererToken,
} from "../services/auth.service.js";
import {
  validerLogin,
  validerForgotPassword,
  validerResetPassword,
  validerVerifyToken,
  validerConfirmEmail,
} from "@clubmanager/types/dist/validators.js";

// ✅ NOUVEAUX IMPORTS: Middleware et Custom Errors
import { requireAuth, AuthContext } from "../middleware/index.js";
import {
  InvalidCredentialsError,
  ValidationError,
  TokenExpiredError,
  TokenInvalidError,
  UserNotFoundError,
  toAuthError,
} from "../errors/index.js";

// Type alias pour compatibilité avec le code existant
type Context = AuthContext;

/**
 * Fonction helper pour définir les cookies via le contexte
 */
function setCookie(
  context: Context,
  name: string,
  value: string,
  options: any,
) {
  if (context.res && typeof context.res.cookie === "function") {
    context.res.cookie(name, value, options);
  }
}

/**
 * Fonction helper pour supprimer les cookies
 */
function clearCookie(context: Context, name: string, options?: any) {
  if (context.res && typeof context.res.clearCookie === "function") {
    context.res.clearCookie(name, options || {});
  }
}

/**
 * Fonction helper pour définir les headers
 */
function setHeader(context: Context, name: string, value: string | string[]) {
  if (context.res && typeof context.res.setHeader === "function") {
    context.res.setHeader(name, value);
  }
}

export const authResolvers = (prisma: PrismaClient) => ({
  Query: {
    /**
     * Vérifier l'authentification de l'utilisateur
     * ✅ REFACTORÉ: Utilise requireAuth middleware
     */
    verifyAuth: requireAuth(async (_: any, __: any, context: Context) => {
      // context.user est garanti d'exister ici grâce à requireAuth
      return {
        success: true,
        user: context.user,
      };
    }),

    /**
     * Vérifier un token de réinitialisation
     * ✅ REFACTORÉ: Utilise custom errors
     */
    verifyResetToken: async (
      _: any,
      { token }: { token: string },
      context: Context,
    ) => {
      try {
        // Validation du format
        const validation = validerVerifyToken({ token });
        if (!validation.success) {
          throw new ValidationError(
            validation.errors?.[0] || "Token invalide",
            validation.errors?.map((e) => ({ field: "token", message: e })),
          );
        }

        if (!token || token.length < 10) {
          throw new TokenInvalidError("Token malformé");
        }

        console.log(
          "🔍 [Auth] Vérification token:",
          token.substring(0, 10) + "...",
        );

        const tokenData = await verifierTokenReset(token);

        if (!tokenData) {
          throw new TokenExpiredError(
            "Le token de réinitialisation a expiré",
            "reset",
          );
        }

        // Vérifier l'expiration
        if (tokenData.expires_at < new Date()) {
          throw new TokenExpiredError(
            "Le token de réinitialisation a expiré",
            "reset",
          );
        }

        console.log(`✅ [Auth] Token reset valide pour: ${tokenData.email}`);

        return {
          valid: true,
          email: tokenData.email,
          userName: `${tokenData.first_name} ${tokenData.last_name}`,
        };
      } catch (error: any) {
        console.error("❌ [Auth] Erreur verify-token:", error);

        // Si c'est déjà une AuthError, la retourner telle quelle
        if (error.extensions?.code) {
          return {
            valid: false,
            error: error.message,
          };
        }

        // Sinon convertir en erreur générique
        return {
          valid: false,
          error: "Erreur serveur lors de la vérification du token",
        };
      }
    },

    /**
     * Vérifier le statut d'authentification
     */
    checkAuthStatus: async (_: any, __: any, context: Context) => {
      if (!context.user) {
        return {
          authenticated: false,
          message: "Non authentifié",
        };
      }

      return {
        authenticated: true,
        user: context.user,
      };
    },

    /**
     * Confirmer l'email avec un token
     */
    confirmEmail: async (
      _: any,
      { token, userId }: { token: string; userId: string },
      context: Context,
    ) => {
      try {
        // Validation
        const validation = validerConfirmEmail({ token, userId });
        if (!validation.success) {
          return {
            success: false,
            message: validation.errors?.[0] || "Données invalides",
            redirect_to: "/pages/connexion?error=invalid_params",
          };
        }

        console.log("🔍 [Auth] Confirmation email pour userId:", userId);

        // Vérifier le token
        const tokenValid = await verifierTokenValidation(
          token,
          parseInt(userId),
        );

        if (!tokenValid) {
          return {
            success: false,
            message: "Token invalide ou expiré",
            redirect_to: "/pages/connexion?error=invalid_token",
          };
        }

        // Confirmer l'email
        const result = await confirmerEmail(parseInt(userId));

        if (!result.success) {
          return {
            success: false,
            message: result.message || "Erreur lors de la confirmation",
            redirect_to: "/pages/connexion?error=confirmation_failed",
          };
        }

        console.log("✅ [Auth] Email confirmé pour userId:", userId);

        return {
          success: true,
          message: "Email confirmé avec succès",
          redirect_to: "/pages/connexion?confirmed=true",
        };
      } catch (error: any) {
        console.error("❌ [Auth] Erreur confirm-email:", error);
        return {
          success: false,
          message: "Erreur serveur",
          redirect_to: "/pages/connexion?error=server_error",
        };
      }
    },

    /**
     * Route de test publique
     */
    testAuth: async () => {
      return {
        success: true,
        message: "Auth module GraphQL is working!",
        timestamp: new Date().toISOString(),
      };
    },
  },

  Mutation: {
    /**
     * Connexion utilisateur
     */
    login: async (
      _: any,
      { input }: { input: { email: string; password: string } },
      context: Context,
    ) => {
      try {
        // Validation
        const validation = validerLogin(input);
        if (!validation.success) {
          throw new GraphQLError(
            validation.errors?.[0] || "Données invalides",
            {
              extensions: { code: "BAD_REQUEST", errors: validation.errors },
            },
          );
        }

        const { email, password } = validation.data!;

        const result = await authentifierUtilisateur(email, password);

        if (!result.success) {
          throw new GraphQLError(result.message, {
            extensions: { code: "UNAUTHORIZED" },
          });
        }

        // Définir le cookie si le contexte response est disponible
        if (result.token) {
          setCookie(context, "token", result.token, {
            httpOnly: true,
            secure: process.env.NODE_ENV === "production",
            sameSite: process.env.NODE_ENV === "production" ? "strict" : "lax",
            domain:
              process.env.NODE_ENV === "production"
                ? "clubmanagment.com"
                : "localhost",
            maxAge: 24 * 60 * 60 * 1000,
          });
        }

        return {
          success: true,
          message: result.message,
          user: result.user,
          token: result.token,
        };
      } catch (error: any) {
        console.error("❌ [Auth] Erreur lors de la connexion:", error);

        if (error instanceof GraphQLError) {
          throw error;
        }

        throw new GraphQLError("Erreur serveur", {
          extensions: { code: "INTERNAL_SERVER_ERROR" },
        });
      }
    },

    /**
     * Déconnexion utilisateur
     */
    logout: async (_: any, __: any, context: Context) => {
      try {
        console.log(
          "🚪 Déconnexion demandée pour utilisateur:",
          context.user?.id,
        );

        const cookieVariants = [
          {
            httpOnly: true,
            secure: true,
            sameSite: "strict" as const,
            domain: "clubmanagment.com",
            path: "/",
          },
          {
            httpOnly: true,
            secure: false,
            sameSite: "lax" as const,
            domain: "localhost",
            path: "/",
          },
          {
            httpOnly: true,
            secure: false,
            sameSite: "lax" as const,
            path: "/",
          },
          { httpOnly: true, secure: false, path: "/" },
          { httpOnly: true, path: "/" },
          { path: "/" },
          {
            httpOnly: true,
            secure: false,
            sameSite: "strict" as const,
            path: "/",
          },
          {
            httpOnly: true,
            secure: false,
            sameSite: "none" as const,
            path: "/",
          },
          {},
        ];

        cookieVariants.forEach((variant, index) => {
          try {
            clearCookie(context, "token", variant);
            console.log(
              `🗑️ [Logout] Suppression cookie 'token' variant ${index + 1}`,
            );
          } catch (error: any) {
            console.log(
              `⚠️ [Logout] Échec variant ${index + 1}:`,
              error.message,
            );
          }
        });

        const expiredDate = "Thu, 01 Jan 1970 00:00:00 GMT";
        const tokenCookieHeaders = [
          `token=; expires=${expiredDate}; path=/; domain=localhost; HttpOnly; SameSite=Lax`,
          `token=; expires=${expiredDate}; path=/; HttpOnly; SameSite=Lax`,
          `token=; expires=${expiredDate}; path=/; domain=localhost`,
          `token=; expires=${expiredDate}; path=/`,
          `token=; max-age=0; path=/; domain=localhost; HttpOnly; SameSite=Lax`,
          `token=; max-age=0; path=/; HttpOnly`,
          `token=; max-age=0; path=/`,
          `token=deleted; expires=${expiredDate}; path=/; domain=localhost; HttpOnly`,
          `token=deleted; expires=${expiredDate}; path=/`,
          `token=; expires=${expiredDate}; path=/; domain=clubmanagment.com; HttpOnly; SameSite=Strict; Secure`,
          `token=; max-age=0; path=/; domain=clubmanagment.com; HttpOnly; SameSite=Strict; Secure`,
        ];

        const allHeaders: string[] = [];
        tokenCookieHeaders.forEach((header, index) => {
          allHeaders.push(header);
          console.log(`🔨 [Logout] Header suppression token ${index + 1}`);
        });

        if (allHeaders.length > 0 && context.res) {
          setHeader(context, "Set-Cookie", allHeaders);
          console.log(
            `🔨 [Logout] ${allHeaders.length} headers Set-Cookie définis`,
          );
        }

        const authCookieNames = [
          "authToken",
          "userData",
          "user",
          "auth_token",
          "access_token",
          "refresh_token",
          "sessionId",
          "session",
          "jwt",
          "JWT",
        ];

        authCookieNames.forEach((cookieName) => {
          cookieVariants.forEach((variant) => {
            try {
              clearCookie(context, cookieName, variant);
            } catch (error: any) {
              // Ignorer les erreurs pour les cookies secondaires
            }
          });
          console.log(`🗑️ [Logout] Cookie "${cookieName}" supprimé`);
        });

        if (context.res) {
          setHeader(context, "Clear-Site-Data", '"cookies", "storage"');
          setHeader(
            context,
            "Cache-Control",
            "no-cache, no-store, must-revalidate",
          );
          setHeader(context, "Pragma", "no-cache");
          setHeader(context, "Expires", "0");
        }

        console.log("✅ [Logout] Déconnexion terminée");

        return {
          success: true,
          message: "Déconnexion réussie - Tous les cookies ont été supprimés",
          cookiesCleared: ["token", ...authCookieNames],
          headersSet: allHeaders.length,
        };
      } catch (error: any) {
        console.error("❌ [Logout] Erreur lors de la déconnexion:", error);
        throw new GraphQLError("Erreur lors de la déconnexion", {
          extensions: { code: "INTERNAL_SERVER_ERROR" },
        });
      }
    },

    /**
     * Demande de réinitialisation de mot de passe
     */
    forgotPassword: async (
      _: any,
      { input }: { input: { email: string } },
      context: Context,
    ) => {
      try {
        // Validation
        const validation = validerForgotPassword(input);
        if (!validation.success) {
          throw new GraphQLError(validation.errors?.[0] || "Email invalide", {
            extensions: { code: "BAD_REQUEST", errors: validation.errors },
          });
        }

        const { email } = validation.data!;

        console.log(
          "🔄 [Auth] Demande réinitialisation mot de passe pour:",
          email,
        );

        const result = await demanderResetMotDePasse(email);

        // Envoyer l'email si un token a été généré
        if (result.token) {
          // On doit récupérer le prénom de l'utilisateur
          const { rechercherUtilisateurParEmail } =
            await import("../services/auth.service.js");
          const user = await rechercherUtilisateurParEmail(email);

          if (user) {
            await envoyerEmailResetMotDePasse(
              email,
              user.first_name,
              result.token,
            );
          }
        }

        return {
          message: result.message,
        };
      } catch (error: any) {
        console.error("❌ [Auth] Erreur forgot-password:", error);

        if (error instanceof GraphQLError) {
          throw error;
        }

        throw new GraphQLError("Erreur serveur", {
          extensions: { code: "INTERNAL_SERVER_ERROR" },
        });
      }
    },

    /**
     * Réinitialiser le mot de passe avec un token
     */
    resetPassword: async (
      _: any,
      { input }: { input: { token: string; newPassword: string } },
      context: Context,
    ) => {
      try {
        // Validation
        const validation = validerResetPassword(input);
        if (!validation.success) {
          return {
            message: "",
            error: validation.errors?.[0] || "Données invalides",
          };
        }

        const { token, newPassword } = validation.data!;

        console.log(
          "🔄 [Auth] Réinitialisation mot de passe avec token:",
          token.substring(0, 10) + "...",
        );

        const result = await reinitialiserMotDePasse(token, newPassword);

        if (!result.success) {
          return {
            message: "",
            error: result.message || result.errors?.join(", "),
          };
        }

        return {
          message: result.message || "Mot de passe réinitialisé avec succès",
          error: null,
        };
      } catch (error: any) {
        console.error("❌ [Auth] Erreur reset-password:", error);
        return {
          message: "",
          error: "Erreur serveur",
        };
      }
    },

    /**
     * Rafraîchir le token d'authentification
     */
    refreshToken: async (_: any, __: any, context: Context) => {
      try {
        if (!context.user) {
          throw new GraphQLError("Non authentifié", {
            extensions: { code: "UNAUTHENTICATED" },
          });
        }

        // Générer un nouveau token
        const newToken = genererToken({
          id: context.user.id,
          email: context.user.email,
          first_name: context.user.first_name,
          last_name: context.user.last_name,
          status_id: context.user.status_id,
          role: context.user.role,
          status: context.user.status,
        });

        // Définir le nouveau cookie
        setCookie(context, "token", newToken, {
          httpOnly: true,
          secure: process.env.NODE_ENV === "production",
          sameSite: process.env.NODE_ENV === "production" ? "strict" : "lax",
          domain:
            process.env.NODE_ENV === "production"
              ? "clubmanagment.com"
              : "localhost",
          maxAge: 24 * 60 * 60 * 1000,
        });

        console.log(
          "✅ [Auth] Token rafraîchi pour utilisateur:",
          context.user.id,
        );

        return {
          success: true,
          message: "Token rafraîchi avec succès",
          token: newToken,
          user: context.user,
        };
      } catch (error: any) {
        console.error("❌ [Auth] Erreur refresh-token:", error);

        if (error instanceof GraphQLError) {
          throw error;
        }

        throw new GraphQLError("Erreur serveur", {
          extensions: { code: "INTERNAL_SERVER_ERROR" },
        });
      }
    },
  },
});
