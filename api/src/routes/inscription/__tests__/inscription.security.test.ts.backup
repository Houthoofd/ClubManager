/**
 * Tests de sécurité pour le module Inscription
 * Vérifie la protection contre les attaques courantes
 */

import { describe, it, expect, jest, beforeEach } from "@jest/globals";
import request from "supertest";
import express from "express";

// Mock du connector MySQL - DOIT être avant les imports des handlers/services
jest.mock("../../../db/connector/mysqlconnector.js", () => {
  return {
    default: {
      getInstance: jest.fn(() => ({
        query: jest.fn(),
      })),
    },
  };
});

import inscriptionRouter from "../inscription.routes.js";
import { inscriptionService } from "../core/services/inscription.service.js";

// Mock du service
jest.mock("../core/services/inscription.service.js", () => ({
  inscriptionService: {
    verifierEmail: jest.fn(),
    inscrireUtilisateur: jest.fn(),
    hashPassword: jest.fn(),
    validerAge: jest.fn(),
  },
}));

describe("Inscription - Tests de sécurité", () => {
  let app: express.Application;

  beforeEach(() => {
    app = express();
    app.use(express.json());
    app.use("/api/inscription", inscriptionRouter);
    jest.clearAllMocks();
  });

  const validInscriptionData = {
    nom: "Dupont",
    prenom: "Jean",
    email: "jean.dupont@example.com",
    password: "SecureP@ss123",
    date: "1990-01-15",
    abonnement: 1,
    genre: 1,
  };

  // ==================== INJECTION SQL ====================
  describe("Protection contre l'injection SQL", () => {
    it("devrait rejeter une tentative d'injection SQL dans le nom", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "'; DROP TABLE utilisateurs; --",
        });

      expect(response.status).toBe(400);
      expect(inscriptionService.inscrireUtilisateur).not.toHaveBeenCalled();
    });

    it("devrait rejeter une tentative d'injection SQL dans l'email", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          email: "admin'--@example.com",
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter une tentative d'injection SQL dans le prénom", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          prenom: "'; DELETE FROM utilisateurs WHERE '1'='1",
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter UNION SELECT dans n'importe quel champ", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "' UNION SELECT * FROM utilisateurs --",
        });

      expect(response.status).toBe(400);
    });
  });

  // ==================== XSS (Cross-Site Scripting) ====================
  describe("Protection contre XSS", () => {
    it("devrait rejeter des scripts dans le nom", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "<script>alert('XSS')</script>",
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter des balises HTML dans le prénom", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          prenom: "<img src=x onerror=alert('XSS')>",
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter du JavaScript encodé", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "&#60;script&#62;alert('XSS')&#60;/script&#62;",
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter des événements JavaScript", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          prenom: "Jean onclick=alert('XSS')",
        });

      expect(response.status).toBe(400);
    });
  });

  // ==================== INJECTION DE COMMANDES ====================
  describe("Protection contre l'injection de commandes", () => {
    it("devrait rejeter des commandes shell dans le nom", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "test; cat /etc/passwd",
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter des pipes", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "test | ls -la",
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter des backticks", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "test`whoami`",
        });

      expect(response.status).toBe(400);
    });
  });

  // ==================== PRIVILEGE ESCALATION ====================
  describe("Protection contre l'escalade de privilèges", () => {
    it("ne devrait pas accepter le champ 'role'", async () => {
      (inscriptionService.inscrireUtilisateur as jest.Mock).mockResolvedValue({
        success: true,
        message: "Inscription réussie",
      });

      await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          role: "admin",
        });

      const callArgs = (inscriptionService.inscrireUtilisateur as jest.Mock)
        .mock.calls[0][0];
      expect(callArgs).not.toHaveProperty("role");
    });

    it("ne devrait pas accepter le champ 'isAdmin'", async () => {
      (inscriptionService.inscrireUtilisateur as jest.Mock).mockResolvedValue({
        success: true,
        message: "Inscription réussie",
      });

      await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          isAdmin: true,
        });

      const callArgs = (inscriptionService.inscrireUtilisateur as jest.Mock)
        .mock.calls[0][0];
      expect(callArgs).not.toHaveProperty("isAdmin");
    });

    it("ne devrait pas accepter le champ 'permissions'", async () => {
      (inscriptionService.inscrireUtilisateur as jest.Mock).mockResolvedValue({
        success: true,
        message: "Inscription réussie",
      });

      await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          permissions: ["admin", "superuser"],
        });

      const callArgs = (inscriptionService.inscrireUtilisateur as jest.Mock)
        .mock.calls[0][0];
      expect(callArgs).not.toHaveProperty("permissions");
    });

    it("ne devrait pas accepter le champ 'isVerified'", async () => {
      (inscriptionService.inscrireUtilisateur as jest.Mock).mockResolvedValue({
        success: true,
        message: "Inscription réussie",
      });

      await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          isVerified: true,
        });

      const callArgs = (inscriptionService.inscrireUtilisateur as jest.Mock)
        .mock.calls[0][0];
      expect(callArgs).not.toHaveProperty("isVerified");
    });
  });

  // ==================== VALIDATION DU MOT DE PASSE ====================
  describe("Sécurité du mot de passe", () => {
    it("devrait rejeter un mot de passe trop simple", async () => {
      const weakPasswords = [
        "password",
        "12345678",
        "qwerty123",
        "Password1",
        "Abcdefgh",
      ];

      for (const password of weakPasswords) {
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password });

        expect(response.status).toBe(400);
      }
    });

    it("devrait exiger au moins une majuscule", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          password: "lowercase123!",
        });

      expect(response.status).toBe(400);
    });

    it("devrait exiger au moins une minuscule", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          password: "UPPERCASE123!",
        });

      expect(response.status).toBe(400);
    });

    it("devrait exiger au moins un chiffre", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          password: "NoNumber!",
        });

      expect(response.status).toBe(400);
    });

    it("devrait exiger au moins un caractère spécial", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          password: "NoSpecial123",
        });

      expect(response.status).toBe(400);
    });

    it("devrait accepter un mot de passe fort", async () => {
      (inscriptionService.inscrireUtilisateur as jest.Mock).mockResolvedValue({
        success: true,
        message: "Inscription réussie",
      });

      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          password: "V3ry$tr0ng!P@ssw0rd",
        });

      expect(response.status).toBe(201);
    });
  });

  // ==================== RATE LIMITING / BRUTE FORCE ====================
  describe("Protection contre le brute force", () => {
    it("devrait gérer de multiples requêtes sans crasher", async () => {
      (inscriptionService.verifierEmail as jest.Mock).mockResolvedValue({
        exists: false,
      });

      const promises = Array.from({ length: 50 }, () =>
        request(app)
          .post("/api/inscription/verification")
          .send({ email: "test@example.com" }),
      );

      const responses = await Promise.all(promises);

      responses.forEach((response) => {
        expect([200, 429, 500]).toContain(response.status);
      });
    });
  });

  // ==================== EMAIL BOMBING ====================
  describe("Protection contre l'email bombing", () => {
    it("devrait normaliser l'email en lowercase", async () => {
      (inscriptionService.verifierEmail as jest.Mock).mockResolvedValue({
        exists: false,
      });

      await request(app)
        .post("/api/inscription/verification")
        .send({ email: "TEST@EXAMPLE.COM" });

      expect(inscriptionService.verifierEmail).toHaveBeenCalledWith(
        "test@example.com",
      );
    });

    it("devrait trim les espaces de l'email", async () => {
      (inscriptionService.verifierEmail as jest.Mock).mockResolvedValue({
        exists: false,
      });

      await request(app)
        .post("/api/inscription/verification")
        .send({ email: "  test@example.com  " });

      expect(inscriptionService.verifierEmail).toHaveBeenCalledWith(
        "test@example.com",
      );
    });
  });

  // ==================== INFORMATION DISCLOSURE ====================
  describe("Protection contre la divulgation d'informations", () => {
    it("ne devrait pas exposer les détails d'erreur serveur", async () => {
      (inscriptionService.inscrireUtilisateur as jest.Mock).mockRejectedValue(
        new Error("Database connection failed: host='localhost' user='root'"),
      );

      const response = await request(app)
        .post("/api/inscription/validation")
        .send(validInscriptionData);

      expect(response.status).toBe(500);
      expect(response.body.message).not.toContain("Database");
      expect(response.body.message).not.toContain("localhost");
      expect(response.body.message).not.toContain("root");
      expect(response.body.message).toContain("Erreur serveur");
    });

    it("ne devrait pas exposer la structure de la base de données", async () => {
      (inscriptionService.inscrireUtilisateur as jest.Mock).mockRejectedValue(
        new Error("Table 'utilisateurs' doesn't exist"),
      );

      const response = await request(app)
        .post("/api/inscription/validation")
        .send(validInscriptionData);

      expect(response.status).toBe(500);
      expect(response.body.message).not.toContain("utilisateurs");
      expect(response.body.message).not.toContain("Table");
    });
  });

  // ==================== MASS ASSIGNMENT ====================
  describe("Protection contre le mass assignment", () => {
    it("devrait ignorer les champs non autorisés", async () => {
      (inscriptionService.inscrireUtilisateur as jest.Mock).mockResolvedValue({
        success: true,
        message: "Inscription réussie",
      });

      await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          id: 999,
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString(),
          deletedAt: null,
          role: "admin",
        });

      const callArgs = (inscriptionService.inscrireUtilisateur as jest.Mock)
        .mock.calls[0][0];

      expect(callArgs).not.toHaveProperty("id");
      expect(callArgs).not.toHaveProperty("createdAt");
      expect(callArgs).not.toHaveProperty("updatedAt");
      expect(callArgs).not.toHaveProperty("deletedAt");
      expect(callArgs).not.toHaveProperty("role");
    });
  });

  // ==================== BUFFER OVERFLOW ====================
  describe("Protection contre le buffer overflow", () => {
    it("devrait rejeter un nom extrêmement long", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "A".repeat(10000),
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter un email extrêmement long", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          email: "a".repeat(5000) + "@example.com",
        });

      expect(response.status).toBe(400);
    });

    it("devrait rejeter un mot de passe extrêmement long", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          password: "A1!a" + "a".repeat(1000),
        });

      expect(response.status).toBe(400);
    });
  });

  // ==================== UNICODE / ENCODING ATTACKS ====================
  describe("Protection contre les attaques Unicode", () => {
    it("devrait rejeter des caractères Unicode dangereux dans le nom", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "Test\u0000User",
        });

      expect(response.status).toBe(400);
    });

    it("devrait gérer correctement les emojis (rejeter)", async () => {
      const response = await request(app)
        .post("/api/inscription/validation")
        .send({
          ...validInscriptionData,
          nom: "Test😀User",
        });

      expect(response.status).toBe(400);
    });
  });

  // ==================== TIMING ATTACKS ====================
  describe("Protection contre les timing attacks", () => {
    it("devrait prendre un temps similaire pour email existant ou non", async () => {
      (inscriptionService.verifierEmail as jest.Mock).mockResolvedValue({
        exists: true,
      });

      const start1 = Date.now();
      await request(app)
        .post("/api/inscription/verification")
        .send({ email: "existing@example.com" });
      const time1 = Date.now() - start1;

      (inscriptionService.verifierEmail as jest.Mock).mockResolvedValue({
        exists: false,
      });

      const start2 = Date.now();
      await request(app)
        .post("/api/inscription/verification")
        .send({ email: "nonexisting@example.com" });
      const time2 = Date.now() - start2;

      // Les temps ne devraient pas différer de plus de 100ms
      expect(Math.abs(time1 - time2)).toBeLessThan(100);
    });
  });

  // ==================== CONTENT TYPE VALIDATION ====================
  describe("Validation du Content-Type", () => {
    it("devrait rejeter un Content-Type non-JSON", async () => {
      const response = await request(app)
        .post("/api/inscription/verification")
        .set("Content-Type", "text/plain")
        .send("email=test@example.com");

      expect([400, 415]).toContain(response.status);
    });
  });
});
