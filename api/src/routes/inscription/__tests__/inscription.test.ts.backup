/**
 * Tests unitaires de base pour le module Inscription
 * Tests des routes, handlers et intégration avec les services
 */

import { describe, it, expect, jest, beforeEach } from "@jest/globals";
import request from "supertest";
import express from "express";

// Mock du connector MySQL - DOIT être avant les imports des handlers/services
jest.mock("../../../db/connector/mysqlconnector.js", () => {
  return {
    default: {
      getInstance: jest.fn(() => ({
        query: jest.fn(),
      })),
    },
  };
});

import inscriptionRouter from "../inscription.routes.js";
import { inscriptionService } from "../core/services/inscription.service.js";

describe("Module Inscription - Tests unitaires", () => {
  let app: express.Application;

  beforeEach(() => {
    // Réinitialiser l'application Express pour chaque test
    app = express();
    app.use(express.json());
    app.use("/api/inscription", inscriptionRouter);

    // Réinitialiser tous les mocks
    jest.clearAllMocks();

    // Spy sur les méthodes du service
    jest.spyOn(inscriptionService, "verifierEmail").mockResolvedValue({
      exists: false,
      message: "Email disponible",
    });
    jest.spyOn(inscriptionService, "inscrireUtilisateur").mockResolvedValue({
      success: true,
      message: "Inscription réussie",
      userId: 1,
    });
  });

  afterEach(() => {
    jest.restoreAllMocks();
  });

  // ==================== TESTS VERIFICATION EMAIL ====================
  describe("POST /api/inscription/verification", () => {
    describe("Cas de succès", () => {
      it("devrait retourner 200 si l'email est disponible", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({ email: "test@example.com" });

        // Assert
        expect(response.status).toBe(200);
        expect(response.body).toEqual({
          success: true,
          exists: false,
          message: "Email disponible",
        });
        expect(inscriptionService.verifierEmail).toHaveBeenCalledWith(
          "test@example.com",
        );
        expect(inscriptionService.verifierEmail).toHaveBeenCalledTimes(1);
      });

      it("devrait normaliser l'email (lowercase, trim)", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        await request(app)
          .post("/api/inscription/verification")
          .send({ email: "  TEST@EXAMPLE.COM  " });

        // Assert
        expect(inscriptionService.verifierEmail).toHaveBeenCalledWith(
          "test@example.com",
        );
      });
    });

    describe("Email déjà existant", () => {
      it("devrait retourner 409 si l'email existe déjà", async () => {
        // Arrange
        jest.spyOn(inscriptionService, "verifierEmail").mockResolvedValue({
          exists: true,
          message: "Cet email est déjà utilisé",
        });

        // Act
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({ email: "existing@example.com" });

        // Assert
        expect(response.status).toBe(409);
        expect(response.body).toEqual({
          success: false,
          exists: true,
          message: "Cet email est déjà utilisé",
        });
      });
    });

    describe("Validation des données", () => {
      it("devrait retourner 400 si l'email est manquant", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({});

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
        expect(response.body.message).toContain("email");
      });

      it("devrait retourner 400 si l'email est invalide", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({ email: "invalid-email" });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
        expect(response.body.message).toContain("email");
      });

      it("devrait retourner 400 si l'email est trop court", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({ email: "a@b" });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
      });

      it("devrait retourner 400 si l'email est trop long", async () => {
        // Act
        const longEmail = "a".repeat(250) + "@test.com";
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({ email: longEmail });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
      });

      it("devrait accepter un email valide standard", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({ email: "user@example.com" });

        // Assert
        expect(response.status).toBe(200);
      });

      it("devrait accepter un email avec sous-domaine", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({ email: "user@subdomain.example.com" });

        // Assert
        expect(response.status).toBe(200);
      });
    });

    describe("Gestion des erreurs", () => {
      it("devrait retourner 500 en cas d'erreur serveur", async () => {
        // Arrange
        jest
          .spyOn(inscriptionService, "verifierEmail")
          .mockRejectedValue(new Error("Database error"));

        // Act
        const response = await request(app)
          .post("/api/inscription/verification")
          .send({ email: "test@example.com" });

        // Assert
        expect(response.status).toBe(500);
        expect(response.body.success).toBe(false);
        expect(response.body.message).toContain("Erreur serveur");
      });
    });
  });

  // ==================== TESTS INSCRIPTION COMPLETE ====================
  describe("POST /api/inscription/validation", () => {
    const validInscriptionData = {
      nom: "Dupont",
      prenom: "Jean",
      email: "jean.dupont@example.com",
      password: "SecureP@ss123",
      date: "1990-01-15",
      abonnement: 1,
      genre: 1,
    };

    describe("Cas de succès", () => {
      it("devrait retourner 201 si l'inscription réussit", async () => {
        // Arrange
        jest
          .spyOn(inscriptionService, "inscrireUtilisateur")
          .mockResolvedValue({
            success: true,
            message: "Inscription réussie",
            userId: 42,
          });

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send(validInscriptionData);

        // Assert
        expect(response.status).toBe(201);
        expect(response.body).toEqual({
          success: true,
          message: "Inscription réussie",
          userId: 42,
        });
        expect(inscriptionService.inscrireUtilisateur).toHaveBeenCalledTimes(1);
      });

      it("devrait appeler le service avec les bonnes données", async () => {
        // Arrange
        jest
          .spyOn(inscriptionService, "inscrireUtilisateur")
          .mockResolvedValue({
            success: true,
            message: "Inscription réussie",
          });

        // Act
        await request(app)
          .post("/api/inscription/validation")
          .send(validInscriptionData);

        // Assert
        expect(inscriptionService.inscrireUtilisateur).toHaveBeenCalledWith(
          expect.objectContaining({
            nom: "Dupont",
            prenom: "Jean",
            email: "jean.dupont@example.com",
            password: "SecureP@ss123",
            date: "1990-01-15",
            abonnement: 1,
            genre: 1,
          }),
        );
      });

      it("devrait accepter des noms avec accents", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({
            ...validInscriptionData,
            nom: "Müller",
            prenom: "François",
          });

        // Assert
        expect(response.status).toBe(201);
      });

      it("devrait accepter des noms composés avec tirets", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({
            ...validInscriptionData,
            nom: "Martin-Dupont",
            prenom: "Jean-Pierre",
          });

        // Assert
        expect(response.status).toBe(201);
      });

      it("devrait accepter des noms avec apostrophes", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({
            ...validInscriptionData,
            nom: "O'Connor",
          });

        // Assert
        expect(response.status).toBe(201);
      });
    });

    describe("Email déjà existant", () => {
      it("devrait retourner 409 si l'email existe déjà", async () => {
        // Arrange
        jest
          .spyOn(inscriptionService, "inscrireUtilisateur")
          .mockResolvedValue({
            success: false,
            message: "Un compte avec cet email existe déjà",
          });

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send(validInscriptionData);

        // Assert
        expect(response.status).toBe(409);
        expect(response.body.success).toBe(false);
        expect(response.body.message).toContain("existe déjà");
      });
    });

    describe("Validation des champs obligatoires", () => {
      it("devrait retourner 400 si le nom est manquant", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, nom: undefined });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
        expect(response.body.message).toContain("nom");
      });

      it("devrait retourner 400 si le prénom est manquant", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, prenom: undefined });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
        expect(response.body.message).toContain("prénom");
      });

      it("devrait retourner 400 si l'email est manquant", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, email: undefined });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
      });

      it("devrait retourner 400 si le mot de passe est manquant", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password: undefined });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
      });

      it("devrait retourner 400 si la date est manquante", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, date: undefined });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
      });

      it("devrait retourner 400 si l'abonnement est manquant", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, abonnement: undefined });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
      });

      it("devrait retourner 400 si le genre est manquant", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, genre: undefined });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
      });
    });

    describe("Validation du nom", () => {
      it("devrait rejeter un nom vide", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, nom: "" });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un nom avec uniquement des espaces", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, nom: "   " });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un nom trop long (>100)", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, nom: "a".repeat(101) });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un nom avec des chiffres", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, nom: "Dupont123" });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un nom avec des caractères spéciaux", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, nom: "Dupont@#$" });

        // Assert
        expect(response.status).toBe(400);
      });
    });

    describe("Validation du prénom", () => {
      it("devrait rejeter un prénom vide", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, prenom: "" });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un prénom trop long (>100)", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, prenom: "a".repeat(101) });

        // Assert
        expect(response.status).toBe(400);
      });
    });

    describe("Validation de l'email", () => {
      it("devrait rejeter un email invalide", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, email: "invalid-email" });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un email sans domaine", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, email: "test@" });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait normaliser l'email en lowercase", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, email: "TEST@EXAMPLE.COM" });

        // Assert
        expect(inscriptionService.inscrireUtilisateur).toHaveBeenCalledWith(
          expect.objectContaining({
            email: "test@example.com",
          }),
        );
      });
    });

    describe("Validation du mot de passe", () => {
      it("devrait rejeter un mot de passe trop court (<8)", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password: "Short1!" });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.message).toContain("8 caractères");
      });

      it("devrait rejeter un mot de passe sans majuscule", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password: "lowercase123!" });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.message).toContain("majuscule");
      });

      it("devrait rejeter un mot de passe sans minuscule", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password: "UPPERCASE123!" });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.message).toContain("minuscule");
      });

      it("devrait rejeter un mot de passe sans chiffre", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password: "NoNumber!" });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.message).toContain("chiffre");
      });

      it("devrait rejeter un mot de passe sans caractère spécial", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password: "NoSpecial123" });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.message).toContain("spécial");
      });

      it("devrait accepter un mot de passe valide", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password: "ValidP@ssw0rd" });

        // Assert
        expect(response.status).toBe(201);
      });

      it("devrait rejeter un mot de passe trop long (>128)", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, password: "A".repeat(129) + "1!" });

        // Assert
        expect(response.status).toBe(400);
      });
    });

    describe("Validation de la date", () => {
      it("devrait rejeter une date invalide", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, date: "invalid-date" });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter une date avec mauvais format", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, date: "15/01/1990" });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter une date trop ancienne (>120 ans)", async () => {
        // Act
        const dateVeryOld = new Date();
        dateVeryOld.setFullYear(dateVeryOld.getFullYear() - 121);
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({
            ...validInscriptionData,
            date: dateVeryOld.toISOString().split("T")[0],
          });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.message).toContain("âge");
      });

      it("devrait rejeter une date trop récente (<5 ans)", async () => {
        // Act
        const dateTooRecent = new Date();
        dateTooRecent.setFullYear(dateTooRecent.getFullYear() - 3);
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({
            ...validInscriptionData,
            date: dateTooRecent.toISOString().split("T")[0],
          });

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.message).toContain("âge");
      });

      it("devrait accepter une date valide (âge 18 ans)", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const date18YearsAgo = new Date();
        date18YearsAgo.setFullYear(date18YearsAgo.getFullYear() - 18);
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({
            ...validInscriptionData,
            date: date18YearsAgo.toISOString().split("T")[0],
          });

        // Assert
        expect(response.status).toBe(201);
      });
    });

    describe("Validation abonnement et genre", () => {
      it("devrait rejeter un abonnement négatif", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, abonnement: -1 });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un abonnement à zéro", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, abonnement: 0 });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un genre négatif", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, genre: -1 });

        // Assert
        expect(response.status).toBe(400);
      });

      it("devrait rejeter un abonnement non-entier", async () => {
        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({ ...validInscriptionData, abonnement: 1.5 });

        // Assert
        expect(response.status).toBe(400);
      });
    });

    describe("Gestion des erreurs", () => {
      it("devrait retourner 500 en cas d'erreur serveur", async () => {
        // Arrange
        jest
          .spyOn(inscriptionService, "inscrireUtilisateur")
          .mockRejectedValue(new Error("Database error"));

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send(validInscriptionData);

        // Assert
        expect(response.status).toBe(500);
        expect(response.body.success).toBe(false);
        expect(response.body.message).toContain("Erreur serveur");
      });

      it("devrait retourner 400 pour une erreur métier", async () => {
        // Arrange
        jest
          .spyOn(inscriptionService, "inscrireUtilisateur")
          .mockResolvedValue({
            success: false,
            message: "Erreur lors de l'inscription",
          });

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send(validInscriptionData);

        // Assert
        expect(response.status).toBe(400);
        expect(response.body.success).toBe(false);
      });
    });

    describe("Sécurité", () => {
      it("ne devrait pas accepter de champs supplémentaires non autorisés", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        await request(app)
          .post("/api/inscription/validation")
          .send({
            ...validInscriptionData,
            role: "admin", // Tentative d'injection de rôle
            isVerified: true,
          });

        // Assert
        const callArgs = (inscriptionService.inscrireUtilisateur as jest.Mock)
          .mock.calls[0][0];
        expect(callArgs).not.toHaveProperty("role");
        expect(callArgs).not.toHaveProperty("isVerified");
      });

      it("devrait protéger contre l'injection SQL dans le nom", async () => {
        // Arrange - déjà mocké dans beforeEach

        // Act
        const response = await request(app)
          .post("/api/inscription/validation")
          .send({
            ...validInscriptionData,
            nom: "'; DROP TABLE users; --",
          });

        // Assert
        expect(response.status).toBe(400); // Rejeté par la regex
      });
    });
  });

  // ==================== TESTS DE STRUCTURE ====================
  describe("Structure et exports", () => {
    it("devrait exposer les routes /verification et /validation", async () => {
      // Act & Assert - vérifier que les routes existent
      const verificationResponse = await request(app)
        .post("/api/inscription/verification")
        .send({});

      const validationResponse = await request(app)
        .post("/api/inscription/validation")
        .send({});

      // Les routes devraient exister (pas 404)
      expect(verificationResponse.status).not.toBe(404);
      expect(validationResponse.status).not.toBe(404);
    });

    it("devrait rejeter les méthodes HTTP non autorisées", async () => {
      // Act
      const getResponse = await request(app).get(
        "/api/inscription/verification",
      );
      const putResponse = await request(app).put("/api/inscription/validation");
      const deleteResponse = await request(app).delete(
        "/api/inscription/verification",
      );

      // Assert
      [getResponse, putResponse, deleteResponse].forEach((response) => {
        expect([404, 405]).toContain(response.status);
      });
    });
  });
});
