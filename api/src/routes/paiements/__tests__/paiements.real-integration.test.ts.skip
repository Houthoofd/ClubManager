/**
 * Tests d'intégration RÉELS du module Paiements avec vraie DB
 * Ces tests utilisent une base MySQL de test via Prisma
 *
 * Pour activer ces tests:
 * 1. Renommer ce fichier en .test.ts (enlever .skip)
 * 2. S'assurer que MySQL est démarré
 * 3. Configurer .env.test avec DATABASE_URL
 * 4. Exécuter: npm test -- paiements.real-integration
 */

// IMPORTANT: Charger .env.test AVANT tout autre import
import dotenv from "dotenv";
import { join, dirname } from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
dotenv.config({
  path: join(__dirname, "../../../../.env.test"),
  override: true,
});

import {
  describe,
  it,
  expect,
  beforeAll,
  afterAll,
  beforeEach,
} from "@jest/globals";
import {
  setupTestDatabase,
  teardownTestDatabase,
} from "../../../tests/setup/testDatabase.js";
import { PrismaClient } from "@prisma/client";

describe("Paiements - Tests d'intégration RÉELS avec DB", () => {
  let testPrisma: PrismaClient;
  let testUserId: number;
  let testPlanId: number;
  let testEcheanceId: number;

  beforeAll(async () => {
    console.log(`🔧 [PAIEMENTS TEST] Début du setup...`);
    const prismaInstance = await setupTestDatabase();
    testPrisma = prismaInstance as PrismaClient;
    console.log(`🔗 [PAIEMENTS TEST] Base de données de test initialisée`);
  });

  afterAll(async () => {
    await teardownTestDatabase();
  });

  beforeEach(async () => {
    console.log(`🧹 [PAIEMENTS TEST] Nettoyage des tables...`);

    // Nettoyer toutes les tables dans le bon ordre (contraintes FK)
    await testPrisma.paiements.deleteMany({});
    await testPrisma.echeances_paiements.deleteMany({});
    await testPrisma.utilisateurs.deleteMany({});
    await testPrisma.plans_tarifaires.deleteMany({});
    await testPrisma.status.deleteMany({});

    console.log("🌱 [PAIEMENTS TEST] Création des données de test...");

    // Créer les données de référence obligatoires
    await testPrisma.status.create({
      data: {
        id: 1,
        nom_role: "Actif",
      },
    });

    await testPrisma.status.create({
      data: {
        id: 2,
        nom_role: "Membre",
      },
    });

    // Créer un plan tarifaire de test
    const plan = await testPrisma.plans_tarifaires.create({
      data: {
        nom_plan: "Plan Test Mensuel",
        description: "Plan de test pour intégration",
        prix: 25.5,
        duree_mois: 1,
        type_plan: "mensuel",
      },
    });
    testPlanId = plan.id;

    // Créer un utilisateur de test
    const user = await testPrisma.utilisateurs.create({
      data: {
        userId: `TEST${Date.now()}`,
        nom_utilisateur: `testuser${Date.now()}`,
        first_name: "John",
        last_name: "Doe",
        email: `john.doe.${Date.now()}@test.com`,
        date_of_birth: new Date("1990-01-01"),
        password: "TempPassword123!",
        status_id: 1,
      },
    });
    testUserId = user.id;

    // Créer une échéance de paiement de test
    const echeance = await testPrisma.echeances_paiements.create({
      data: {
        utilisateur_id: testUserId,
        montant: 25.5,
        date_echeance: new Date("2026-06-30"),
        statut: "en attente",
        abonnement_id: testPlanId,
      },
    });
    testEcheanceId = echeance.id;

    console.log(`✅ [PAIEMENTS TEST] Données de test créées:
      - Utilisateur ID: ${testUserId}
      - Plan ID: ${testPlanId}
      - Échéance ID: ${testEcheanceId}`);
  });

  describe("Connexion et opérations de base DB", () => {
    it("devrait se connecter à la base de données de test", async () => {
      expect(testPrisma).toBeDefined();
    });

    it("devrait créer une échéance dans la DB", async () => {
      const echeance = await testPrisma.echeances_paiements.findUnique({
        where: { id: testEcheanceId },
      });

      expect(echeance).toBeDefined();
      expect(echeance?.id).toBe(testEcheanceId);
      expect(echeance?.utilisateur_id).toBe(testUserId);
      expect(echeance?.montant).toBe(25.5);
      expect(echeance?.statut).toBe("en attente");
    });

    it("devrait récupérer les échéances d'un utilisateur", async () => {
      const echeances = await testPrisma.echeances_paiements.findMany({
        where: { utilisateur_id: testUserId },
      });

      expect(echeances).toBeDefined();
      expect(echeances.length).toBeGreaterThan(0);
      expect(echeances[0].utilisateur_id).toBe(testUserId);
    });

    it("devrait retourner un tableau vide pour un utilisateur sans échéances", async () => {
      const echeances = await testPrisma.echeances_paiements.findMany({
        where: { utilisateur_id: 999999 },
      });

      expect(echeances).toBeDefined();
      expect(echeances.length).toBe(0);
    });
  });

  describe("Opérations CRUD sur les paiements", () => {
    it("devrait créer un nouveau paiement", async () => {
      const paiement = await testPrisma.paiements.create({
        data: {
          utilisateur_id: testUserId,
          montant: 25.5,
          date_paiement: new Date(),
          mode_paiement: "carte",
          statut_paiement: "completed",
          stripe_payment_intent_id: "pi_test_12345",
          abonnement_id: testPlanId,
        },
      });

      expect(paiement).toBeDefined();
      expect(paiement.id).toBeGreaterThan(0);
      expect(paiement.montant).toBe(25.5);
      expect(paiement.statut_paiement).toBe("completed");
    });

    it("devrait récupérer tous les paiements", async () => {
      // Créer quelques paiements
      await testPrisma.paiements.create({
        data: {
          utilisateur_id: testUserId,
          montant: 25.5,
          date_paiement: new Date(),
          mode_paiement: "carte",
          statut_paiement: "completed",
          abonnement_id: testPlanId,
        },
      });

      await testPrisma.paiements.create({
        data: {
          utilisateur_id: testUserId,
          montant: 50.0,
          date_paiement: new Date(),
          mode_paiement: "virement",
          statut_paiement: "completed",
          abonnement_id: testPlanId,
        },
      });

      const paiements = await testPrisma.paiements.findMany({
        where: { utilisateur_id: testUserId },
      });

      expect(paiements).toBeDefined();
      expect(paiements.length).toBe(2);
    });

    it("devrait récupérer les paiements avec pagination", async () => {
      // Créer 5 paiements
      for (let i = 0; i < 5; i++) {
        await testPrisma.paiements.create({
          data: {
            utilisateur_id: testUserId,
            montant: 25.5,
            date_paiement: new Date(),
            mode_paiement: "carte",
            statut_paiement: "completed",
            abonnement_id: testPlanId,
          },
        });
      }

      // Page 1 (2 premiers)
      const page1 = await testPrisma.paiements.findMany({
        where: { utilisateur_id: testUserId },
        take: 2,
        skip: 0,
      });

      // Page 2 (2 suivants)
      const page2 = await testPrisma.paiements.findMany({
        where: { utilisateur_id: testUserId },
        take: 2,
        skip: 2,
      });

      expect(page1.length).toBe(2);
      expect(page2.length).toBe(2);
      expect(page1[0].id).not.toBe(page2[0].id);
    });
  });

  describe("Mise à jour du statut des échéances", () => {
    it("devrait mettre à jour le statut d'une échéance en 'payé'", async () => {
      const updated = await testPrisma.echeances_paiements.update({
        where: { id: testEcheanceId },
        data: { statut: "payé" },
      });

      expect(updated.statut).toBe("payé");

      const echeance = await testPrisma.echeances_paiements.findUnique({
        where: { id: testEcheanceId },
      });
      expect(echeance?.statut).toBe("payé");
    });

    it("ne devrait pas pouvoir payer deux fois la même échéance", async () => {
      // Première mise à jour
      await testPrisma.echeances_paiements.update({
        where: { id: testEcheanceId },
        data: { statut: "payé" },
      });

      // Vérifier le statut
      const echeance = await testPrisma.echeances_paiements.findUnique({
        where: { id: testEcheanceId },
      });

      expect(echeance?.statut).toBe("payé");

      // Une logique métier devrait empêcher un second paiement
      // Ici on vérifie juste que le statut est déjà 'payé'
      expect(echeance?.statut).not.toBe("en attente");
    });
  });

  describe("Statistiques et agrégations", () => {
    it("devrait calculer le total des paiements d'un utilisateur", async () => {
      // Créer plusieurs paiements
      await testPrisma.paiements.create({
        data: {
          utilisateur_id: testUserId,
          montant: 25.5,
          date_paiement: new Date(),
          mode_paiement: "carte",
          statut_paiement: "completed",
          abonnement_id: testPlanId,
        },
      });

      await testPrisma.paiements.create({
        data: {
          utilisateur_id: testUserId,
          montant: 50.0,
          date_paiement: new Date(),
          mode_paiement: "carte",
          statut_paiement: "completed",
          abonnement_id: testPlanId,
        },
      });

      const result = await testPrisma.paiements.aggregate({
        where: { utilisateur_id: testUserId },
        _sum: { montant: true },
        _count: true,
      });

      expect(result._sum.montant).toBe(75.5);
      expect(result._count).toBe(2);
    });

    it("devrait compter les échéances par statut", async () => {
      // Créer plusieurs échéances avec différents statuts
      await testPrisma.echeances_paiements.create({
        data: {
          utilisateur_id: testUserId,
          montant: 25.5,
          date_echeance: new Date("2026-07-31"),
          statut: "payé",
          abonnement_id: testPlanId,
        },
      });

      await testPrisma.echeances_paiements.create({
        data: {
          utilisateur_id: testUserId,
          montant: 25.5,
          date_echeance: new Date("2026-08-31"),
          statut: "en attente",
          abonnement_id: testPlanId,
        },
      });

      const enAttente = await testPrisma.echeances_paiements.count({
        where: {
          utilisateur_id: testUserId,
          statut: "en attente",
        },
      });

      const payees = await testPrisma.echeances_paiements.count({
        where: {
          utilisateur_id: testUserId,
          statut: "payé",
        },
      });

      expect(enAttente).toBe(2); // L'échéance du beforeEach + la nouvelle
      expect(payees).toBe(1);
    });
  });

  describe("Relations et jointures", () => {
    it("devrait récupérer les paiements avec les infos utilisateur", async () => {
      await testPrisma.paiements.create({
        data: {
          utilisateur_id: testUserId,
          montant: 25.5,
          date_paiement: new Date(),
          mode_paiement: "carte",
          statut_paiement: "completed",
          abonnement_id: testPlanId,
        },
      });

      const paiements = await testPrisma.paiements.findMany({
        where: { utilisateur_id: testUserId },
        include: {
          utilisateurs: {
            select: {
              id: true,
              first_name: true,
              last_name: true,
              email: true,
            },
          },
        },
      });

      expect(paiements.length).toBeGreaterThan(0);
      expect(paiements[0].utilisateurs).toBeDefined();
      expect(paiements[0].utilisateurs.first_name).toBe("John");
      expect(paiements[0].utilisateurs.last_name).toBe("Doe");
    });

    it("devrait récupérer les échéances avec le plan tarifaire", async () => {
      const echeances = await testPrisma.echeances_paiements.findMany({
        where: { utilisateur_id: testUserId },
        include: {
          plans_tarifaires: {
            select: {
              id: true,
              nom_plan: true,
              prix: true,
            },
          },
        },
      });

      expect(echeances.length).toBeGreaterThan(0);
      expect(echeances[0].plans_tarifaires).toBeDefined();
      expect(echeances[0].plans_tarifaires.nom_plan).toBe("Plan Test Mensuel");
      expect(echeances[0].plans_tarifaires.prix).toBe(25.5);
    });
  });

  describe("Gestion des erreurs et contraintes", () => {
    it("devrait échouer lors de la création d'un paiement avec utilisateur inexistant", async () => {
      await expect(
        testPrisma.paiements.create({
          data: {
            utilisateur_id: 999999,
            montant: 25.5,
            date_paiement: new Date(),
            mode_paiement: "carte",
            statut_paiement: "completed",
            abonnement_id: testPlanId,
          },
        }),
      ).rejects.toThrow();
    });

    it("devrait échouer lors de la création d'une échéance avec plan inexistant", async () => {
      await expect(
        testPrisma.echeances_paiements.create({
          data: {
            utilisateur_id: testUserId,
            montant: 25.5,
            date_echeance: new Date("2026-12-31"),
            statut: "en attente",
            abonnement_id: 999999,
          },
        }),
      ).rejects.toThrow();
    });
  });

  describe("Performance et concurrence", () => {
    it("devrait gérer plusieurs insertions simultanées", async () => {
      const promises = Array.from({ length: 10 }, (_, i) =>
        testPrisma.paiements.create({
          data: {
            utilisateur_id: testUserId,
            montant: 25.5 + i,
            date_paiement: new Date(),
            mode_paiement: "carte",
            statut_paiement: "completed",
            abonnement_id: testPlanId,
          },
        }),
      );

      const results = await Promise.all(promises);

      expect(results.length).toBe(10);
      results.forEach((result, i) => {
        expect(result.montant).toBe(25.5 + i);
      });
    });

    it("devrait exécuter une requête complexe en moins de 1 seconde", async () => {
      // Créer quelques données
      for (let i = 0; i < 5; i++) {
        await testPrisma.paiements.create({
          data: {
            utilisateur_id: testUserId,
            montant: 25.5,
            date_paiement: new Date(),
            mode_paiement: "carte",
            statut_paiement: "completed",
            abonnement_id: testPlanId,
          },
        });
      }

      const startTime = Date.now();

      await testPrisma.paiements.findMany({
        where: { utilisateur_id: testUserId },
        include: {
          utilisateurs: true,
          plans_tarifaires: true,
        },
        orderBy: { date_paiement: "desc" },
      });

      const duration = Date.now() - startTime;

      expect(duration).toBeLessThan(1000);
    });
  });
});

/**
 * NOTES D'EXÉCUTION:
 *
 * Ces tests sont désactivés par défaut (.skip) car ils nécessitent:
 * 1. MySQL en cours d'exécution
 * 2. Une base de données de test configurée
 * 3. Les migrations Prisma appliquées
 *
 * Pour les activer:
 * - Renommer en .test.ts
 * - Vérifier .env.test
 * - npm test -- paiements.real-integration
 */
