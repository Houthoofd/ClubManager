# =====================================================
# FICHIER DE CONFIGURATION POUR LES TESTS
# ClubManager API - Environnement de test
# =====================================================
#
# INSTRUCTIONS:
# 1. Copiez ce fichier vers .env.test
# 2. Ajustez les valeurs si nécessaire
#
# =====================================================

# =====================================================
# BASE DE DONNÉES (TEST)
# =====================================================

DATABASE_URL="mysql://root@localhost:3306/clubmanager_test"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clubmanager_test

# =====================================================
# SÉCURITÉ & AUTHENTIFICATION
# =====================================================

# JWT - JSON Web Tokens
JWT_SECRET=test_secret_key_for_integration_tests_minimum_32_characters_long_abc123
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# =====================================================
# STRIPE (PAIEMENTS) - Mode test
# =====================================================

# Clé secrète Stripe (mode test)
# Pour les tests, utilisez une clé de test Stripe ou une clé factice
STRIPE_SECRET_KEY=sk_test_mock_key_for_testing_only_do_not_use_in_production_12345
STRIPE_PUBLISHABLE_KEY=pk_test_mock_key_for_testing_only

# Webhook Stripe (pour les tests d'intégration)
STRIPE_WEBHOOK_SECRET=whsec_test_mock_webhook_secret_for_testing

# =====================================================
# EMAIL (SendGrid ou autre service)
# =====================================================

# Configuration Email pour les notifications
EMAIL_USER=test@clubmanager.local
EMAIL_PASS=test_password_for_email_service
EMAIL_FROM=noreply@clubmanager.local
EMAIL_HOST=smtp.test.local
EMAIL_PORT=587

# SendGrid (alternatif)
SENDGRID_API_KEY=SG.test_api_key_for_testing_only
SENDGRID_FROM_EMAIL=test@test.com
SENDGRID_SANDBOX=true

# =====================================================
# URLS & DOMAINES
# =====================================================

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# =====================================================
# SMS & NOTIFICATIONS (optionnel)
# =====================================================

# Twilio (pour les SMS de récupération)
TWILIO_ACCOUNT_SID=test_twilio_account_sid
TWILIO_AUTH_TOKEN=test_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# STOCKAGE (AWS S3 ou autre)
# =====================================================

# AWS S3 pour les images/fichiers
AWS_ACCESS_KEY_ID=test_aws_access_key
AWS_SECRET_ACCESS_KEY=test_aws_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=clubmanager-test-bucket

# =====================================================
# ENVIRONNEMENT
# =====================================================

# Mode de l'application
NODE_ENV=test
PORT=3000

# Logging
LOG_LEVEL=error

# =====================================================
# LIMITES & SÉCURITÉ
# =====================================================

# Rate limiting (pour éviter les abus)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Taille maximum des uploads
MAX_FILE_SIZE=5242880

# =====================================================
# OPTIONS DE TEST
# =====================================================

# Désactiver certaines vérifications en test
SKIP_EMAIL_VERIFICATION=true
SKIP_SMS_VERIFICATION=true
MOCK_STRIPE_PAYMENTS=true
MOCK_EMAIL_SENDING=true

# Timeout pour les tests
TEST_TIMEOUT=30000

# =====================================================
# FIN DE LA CONFIGURATION
# =====================================================
